---
import type { CollectionEntry } from "astro:content";
import PostCover from "@/components/PostCover.astro";
import { CATEGORIES, readingMinutes, formatDate } from "@/lib/blog";
import { dict } from "@/lib/i18n";
interface Props { post: CollectionEntry<"blog">; lang: "ar" | "en"; large?: boolean; eager?: boolean }
const { post, lang, large = false, eager = false } = Astro.props;
const t = dict(lang);
const cat = CATEGORIES[post.data.category][lang];
---
<a href={`/blog/${post.id}`} class:list={["group flex flex-col overflow-hidden rounded-3xl border border-line bg-white transition-shadow hover:shadow-[0_10px_28px_rgba(50,40,37,0.08)]", large && "sm:col-span-2 sm:flex-row"]}>
  <PostCover category={post.data.category} cover={post.data.cover} alt={post.data.title} eager={eager}
    class={large ? "h-44 w-full sm:h-auto sm:w-1/2 sm:min-h-[260px]" : "h-44 w-full"} />
  <div class:list={["flex flex-1 flex-col p-4", large && "sm:justify-center sm:p-7"]}>
    <span class="text-[12px] font-bold text-brand-deep">{cat}</span>
    <h2 class:list={["mt-1 line-clamp-2 font-extrabold text-ink group-hover:text-brand", large ? "text-[18px] leading-7 sm:text-[22px] sm:leading-9" : "text-[16px] leading-6"]}>{post.data.title}</h2>
    <p class="mt-1.5 line-clamp-2 text-[14px] leading-5 text-muted">{post.data.description}</p>
    <div class="mt-auto flex items-center gap-2 pt-2.5 text-[12px] font-bold text-muted">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post.body)} {t.minRead}</span>
    </div>
  </div>
</a>
