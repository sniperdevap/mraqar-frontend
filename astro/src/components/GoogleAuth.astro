---
/**
 * "Continue with Google" (Google Identity Services). Google's own button sits
 * invisibly over ours, so the tap opens Google's sign-in, while the look matches
 * the card. New accounts are asked for their Kuwait mobile number once.
 * Without PUBLIC_GOOGLE_CLIENT_ID the button shows "coming soon".
 */
import type { Lang } from "@/lib/i18n";
interface Props { lang: Lang; next?: string; form?: string }
const { lang, next = "/", form } = Astro.props;
const ar = lang === "ar";
const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || process.env.PUBLIC_GOOGLE_CLIENT_ID || "";
---
<div class="relative" data-google-auth data-client-id={clientId} data-next={next} data-form={form} data-lang={lang}>
  <div data-g-start class="relative">
    <button type="button" class="flex h-11 w-full items-center justify-center gap-2.5 rounded-xl border border-[#d5d3d6] bg-white text-[14.5px] font-bold text-ink transition hover:bg-canvas" data-g-fallback>
      <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
      {ar ? "المتابعة بحساب Google" : "Continue with Google"}
    </button>
    <div data-g-overlay class="absolute inset-0 flex items-center justify-center overflow-hidden opacity-[0.011]" aria-hidden="true"></div>
  </div>
  <p data-g-note class="mt-2 hidden text-center text-[13px] font-semibold text-muted">{ar ? "الدخول عبر Google سيتوفر قريبًا." : "Google sign-in is coming soon."}</p>
  <div data-g-phone class="hidden space-y-3 rounded-2xl border border-line bg-canvas p-4">
    <p class="text-[15px] font-extrabold text-ink">{ar ? "خطوة أخيرة" : "One last step"}</p>
    <p class="text-[13.5px] text-muted">{ar ? "أدخل رقم موبايلك لإكمال إنشاء الحساب." : "Enter your mobile number to finish creating your account."}</p>
    <div class="flex gap-2" dir="ltr">
      <span class="flex h-[52px] shrink-0 items-center gap-1.5 rounded-2xl border border-line bg-white px-3.5 text-[14px] font-bold"><span class="text-[11px] text-muted">KW</span>+965</span>
      <input data-g-phone-input inputmode="numeric" maxlength="8" class="h-[52px] w-full rounded-2xl border border-line bg-white px-4 text-[15px] outline-none focus:border-brand" placeholder={ar ? "رقم الموبايل" : "Mobile number"} />
    </div>
    <button type="button" data-g-finish class="flex h-[52px] w-full items-center justify-center rounded-2xl bg-brand text-[15px] font-bold text-white disabled:opacity-50">{ar ? "إكمال إنشاء الحساب" : "Finish creating account"}</button>
  </div>
  <p data-g-error class="mt-2 hidden text-center text-[13px] font-semibold text-brand" role="alert"></p>
</div>

<script>
  type GId = { initialize: (o: object) => void; renderButton: (el: HTMLElement, o: object) => void };
  const box = document.querySelector<HTMLElement>("[data-google-auth]");
  if (box) {
    const clientId = box.dataset.clientId;
    const $ = <T extends HTMLElement>(s: string) => box.querySelector<T>(s)!;
    const ar = box.dataset.lang === "ar";
    let credential = "";
    const extras = () => {
      const f = box.dataset.form ? (document.getElementById(box.dataset.form) as HTMLFormElement | null) : null;
      if (!f) return {};
      const d = new FormData(f);
      return { name: d.get("name"), accountType: d.get("accountType"), userType: d.get("userType"), licenseNumber: d.get("licenseNumber") };
    };
    const fail = (m?: string) => { const e = $("[data-g-error]"); e.textContent = m || (ar ? "تعذر الدخول عبر Google، حاول مرة أخرى." : "Google sign-in failed, please try again."); e.classList.remove("hidden"); };
    const send = async (phone?: string) => {
      const r = await fetch("/api/auth/google", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ credential, phone, next: box.dataset.next, ...extras() }) }).catch(() => null);
      const j = r ? await r.json().catch(() => ({})) : {};
      if (!r || !j.ok) return fail(j.message === "phone" ? (ar ? "رقم الموبايل من 8 أرقام" : "8-digit mobile number") : undefined);
      if (j.needsPhone) { $("[data-g-start]").classList.add("hidden"); $("[data-g-phone]").classList.remove("hidden"); return; }
      location.href = j.redirect || "/";
    };
    $("[data-g-finish]").addEventListener("click", () => send($<HTMLInputElement>("[data-g-phone-input]").value.replace(/\D/g, "")));
    if (!clientId) {
      $("[data-g-fallback]").addEventListener("click", () => $("[data-g-note]").classList.remove("hidden"));
    } else {
      const s = document.createElement("script");
      s.src = "https://accounts.google.com/gsi/client"; s.async = true;
      s.onload = () => {
        const g = (window as unknown as { google?: { accounts: { id: GId } } }).google;
        if (!g) return;
        g.accounts.id.initialize({ client_id: clientId, callback: (r: { credential: string }) => { credential = r.credential; send(); } });
        g.accounts.id.renderButton($("[data-g-overlay]"), { type: "standard", theme: "outline", size: "large", shape: "pill", text: "continue_with", width: Math.min(400, Math.round(box.getBoundingClientRect().width)), locale: ar ? "ar" : "en" });
      };
      document.head.appendChild(s);
    }
  }
</script>
