---
import type { Area, PropertyType, Lang } from "@/lib/api";
import { dict } from "@/lib/i18n";

interface Props {
  lang: Lang; areas: Area[]; types: PropertyType[];
  purpose?: string; propertyType?: string; selectedAreas?: string[];
  minPrice?: string; maxPrice?: string; showPrice?: boolean; compact?: boolean;
}
const { lang, areas, types, purpose = "", propertyType = "", selectedAreas = [], minPrice = "", maxPrice = "", showPrice = false, compact = false } = Astro.props;
const t = dict(lang);
const purposes = [["sale", t.sale], ["rent", t.rent], ["exchange", t.exchange]] as const;
const areaData = areas.map((a) => ({ id: String(a.id), l: lang === "ar" ? a.labelAr : a.label, g: lang === "ar" ? a.governorateAr : a.governorate }));
const chosen = areaData.filter((a) => selectedAreas.includes(a.id));
---
<form action="/search" method="get" class:list={["space-y-3.5", !compact && "rounded-3xl border border-line bg-white p-4 shadow-[0_10px_30px_rgba(16,24,40,0.06)] sm:p-5"]} data-search-form>
  <fieldset class="grid grid-cols-3 gap-1 rounded-2xl bg-canvas p-1">
    <legend class="sr-only">{t.sale} / {t.rent} / {t.exchange}</legend>
    {purposes.map(([v, label]) => (
      <label class="cursor-pointer">
        <input type="radio" name="purpose" value={v} class="peer sr-only" checked={purpose === v} />
        <span class="flex h-11 items-center justify-center rounded-xl text-[15px] text-muted transition-all peer-checked:bg-white peer-checked:font-semibold peer-checked:text-ink peer-checked:shadow-sm peer-focus-visible:outline-2 peer-focus-visible:outline-brand">{label}</span>
      </label>
    ))}
  </fieldset>

  <!-- Area picker: type to search, grouped by governorate, several at once -->
  <div class="relative" data-area-picker data-placeholder={t.allAreas}>
    <div class="flex min-h-13 w-full cursor-text flex-wrap items-center gap-1.5 rounded-xl border border-line bg-white px-3.5 py-2 transition-colors focus-within:border-brand" data-area-box>
      {chosen.map((a) => (
        <span class="inline-flex items-center gap-1 rounded-lg bg-brand-soft px-2.5 py-1 text-[14px] text-ink" data-chip={a.id}>{a.l}
          <button type="button" class="text-muted hover:text-brand" data-remove={a.id} aria-label="×">×</button>
          <input type="hidden" name="area" value={a.id} />
        </span>
      ))}
      <input type="text" autocomplete="off" class="min-w-[8rem] flex-1 border-0 bg-transparent text-[16px] outline-none placeholder:text-gray-400" placeholder={chosen.length ? "" : t.allAreas} aria-label={t.allAreas} data-area-input />
      <svg class="pointer-events-none shrink-0 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </div>
    <div class="absolute inset-x-0 top-full z-20 mt-1.5 hidden max-h-80 overflow-y-auto rounded-2xl border border-line bg-white py-1.5 shadow-[0_12px_32px_rgba(16,24,40,0.12)]" role="listbox" data-area-list></div>
    <script type="application/json" data-area-json set:html={JSON.stringify(areaData)}></script>
  </div>

  <div class="relative">
    <select name="propertyType" class="h-13 w-full appearance-none rounded-xl border border-line bg-white px-3.5 text-[16px] text-ink outline-none focus:border-brand" aria-label={t.propertyType}>
      <option value="">{t.propertyType}</option>
      {types.map((ty) => <option value={String(ty.id)} selected={propertyType === String(ty.id)}>{lang === "ar" ? ty.labelAr : ty.label}</option>)}
    </select>
    <svg class="pointer-events-none absolute end-3.5 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </div>

  {showPrice && (
    <div class="grid grid-cols-2 gap-3">
      <input type="number" inputmode="numeric" name="minPrice" value={minPrice} placeholder={t.priceFrom} class="h-13 rounded-xl border border-line bg-white px-3.5 text-[16px] outline-none focus:border-brand" />
      <input type="number" inputmode="numeric" name="maxPrice" value={maxPrice} placeholder={t.priceTo} class="h-13 rounded-xl border border-line bg-white px-3.5 text-[16px] outline-none focus:border-brand" />
    </div>
  )}

  <button class="flex h-13 w-full items-center justify-center gap-2 rounded-xl bg-brand text-[16px] font-semibold text-white shadow-[0_8px_20px_rgba(225,29,29,0.22)] transition-colors hover:bg-brand-dark active:scale-[0.99]">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    {t.searchBtn}
  </button>
</form>

<script>
  type A = { id: string; l: string; g: string };
  document.querySelectorAll<HTMLElement>("[data-area-picker]").forEach((root) => {
    const box = root.querySelector<HTMLElement>("[data-area-box]")!;
    const input = root.querySelector<HTMLInputElement>("[data-area-input]")!;
    const list = root.querySelector<HTMLElement>("[data-area-list]")!;
    const all: A[] = JSON.parse(root.querySelector("[data-area-json]")!.textContent || "[]");
    const placeholder = root.dataset.placeholder || "";
    const selected = () => Array.from(box.querySelectorAll<HTMLElement>("[data-chip]")).map((c) => c.dataset.chip!);

    const addChip = (a: A) => {
      const chip = document.createElement("span");
      chip.className = "inline-flex items-center gap-1 rounded-lg bg-brand-soft px-2.5 py-1 text-[14px] text-ink";
      chip.dataset.chip = a.id;
      chip.append(a.l);
      const x = document.createElement("button"); x.type = "button"; x.className = "text-muted hover:text-brand"; x.dataset.remove = a.id; x.textContent = "×"; x.setAttribute("aria-label", "×");
      const h = document.createElement("input"); h.type = "hidden"; h.name = "area"; h.value = a.id;
      chip.append(" ", x, h);
      box.insertBefore(chip, input);
      input.placeholder = "";
    };
    const render = () => {
      const q = input.value.trim().toLowerCase();
      const sel = selected();
      const items = all.filter((a) => !sel.includes(a.id) && a.l.toLowerCase().includes(q));
      list.innerHTML = "";
      if (!items.length) { list.innerHTML = '<p class="px-4 py-5 text-center text-[14px] text-gray-400">—</p>'; return; }
      let group = "";
      for (const a of items) {
        if (a.g !== group) {
          group = a.g;
          const h = document.createElement("p");
          h.className = "sticky top-0 bg-white/95 px-4 pt-2.5 pb-1 text-[12px] font-semibold text-gray-400";
          h.textContent = group; list.append(h);
        }
        const o = document.createElement("button");
        o.type = "button"; o.setAttribute("role", "option");
        o.className = "mx-1.5 flex w-[calc(100%-0.75rem)] rounded-lg px-3 py-2.5 text-start text-[15.5px] hover:bg-brand-soft focus:bg-brand-soft focus:outline-none";
        o.textContent = a.l;
        o.addEventListener("click", () => { addChip(a); input.value = ""; close(); });
        list.append(o);
      }
    };
    const open = () => { list.classList.remove("hidden"); render(); };
    const close = () => { list.classList.add("hidden"); if (!selected().length) input.placeholder = placeholder; };
    box.addEventListener("click", (e) => {
      const rm = (e.target as HTMLElement).closest<HTMLElement>("[data-remove]");
      if (rm) { box.querySelector(`[data-chip="${rm.dataset.remove}"]`)?.remove(); if (!list.classList.contains("hidden")) render(); else close(); return; }
      input.focus(); open();
    });
    input.addEventListener("focus", open);
    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); list.querySelector<HTMLButtonElement>("[role=option]")?.click(); } if (e.key === "Escape") close(); });
    document.addEventListener("click", (e) => { if (!root.contains(e.target as Node)) close(); });
  });
</script>
