---
/**
 * Compact listing row (same structure as the leading Kuwait listing sites):
 * 120px tall, photo strip on the start side, one-line title, price + time,
 * two-line description. The whole row is one link.
 */
import type { Ad, Area, Lang } from "@/lib/api";
import { mediaUrl, isFeatured } from "@/lib/api";
import { adHref } from "@/lib/ad-url";
import { adTitle, timeAgo, dict } from "@/lib/i18n";

interface Props { ad: Ad; areas: Area[]; lang: Lang; eager?: boolean; headingLevel?: "h2" | "h3" }
const { ad, areas, lang, eager = false, headingLevel = "h3" } = Astro.props;
const t = dict(lang);
const href = adHref(ad, areas);
const title = adTitle(ad, lang);
const value = Number(ad.price || 0);
const unit = ad.priceUnit === "thousand" ? (lang === "ar" ? "الف" : "K") : lang === "ar" ? "د.ك" : "KD";
const featured = isFeatured(ad);
const first = ad.media?.[0];
const img = first ? mediaUrl(first, true) : "";
const flat = (ad.description || "").replace(/\s+/g, " ").trim();
const excerpt = flat.length > 14 ? flat.slice(0, 14).replace(/\s+\S*$/, "") + "…" : flat;
const Heading = headingLevel;
---
<article class:list={["ad-row group relative isolate flex min-h-[120px] overflow-hidden rounded-[18px] border bg-white shadow-[0_2px_10px_rgba(50,40,37,0.07)] transition-shadow hover:shadow-[0_8px_24px_rgba(50,40,37,0.12)]", featured ? "ad-featured" : "border-line"]}>
  <a href={href} class="absolute inset-0 z-20 rounded-[18px]" aria-label={title} data-astro-prefetch></a>

  {featured && (
    <span class="ad-ribbon">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.94 14.06A2 2 0 0 0 8.5 12.62L2.37 11.04a.5.5 0 0 1 0-.96L8.5 8.5a2 2 0 0 0 1.44-1.44l1.58-6.13a.5.5 0 0 1 .96 0l1.58 6.13A2 2 0 0 0 15.5 8.5l6.13 1.58a.5.5 0 0 1 0 .96L15.5 12.62a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0z"/></svg>
      {t.featured}
    </span>
  )}
  <div class="relative w-[92px] shrink-0 bg-[#f1efed]">
    {img ? (
      <img src={img} alt={title} width="92" height="120" class="absolute inset-0 size-full object-cover" loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
    ) : (
      <span class="absolute inset-0 flex items-center justify-center text-[#c9c4c1]" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
      </span>
    )}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center p-2 ps-3 sm:px-[18px] sm:py-2.5">
    <Heading class="line-clamp-1 text-[15px] font-extrabold leading-[21px] text-ink sm:text-[17px] sm:leading-7">{excerpt || title}</Heading>
    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="inline-flex items-baseline gap-1">
        {value ? (
          <><span class="text-[14px] font-extrabold text-brand-deep sm:text-[16px]">{value.toLocaleString("en-US")}</span><span class="text-[11px] font-semibold text-muted">{unit}{ad.purpose === "rent" ? ` / ${t.monthly}` : ""}</span></>
        ) : (
          <><span class="text-[13px] font-extrabold text-brand-deep">{t.priceOnRequest}</span>{ad.purpose === "rent" && <span class="text-[12px] font-semibold text-muted"> / {t.monthly}</span>}</>
        )}
      </span>
      <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-muted">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <time datetime={ad.createdAt}>{timeAgo(ad.createdAt, lang)}</time>
      </span>
    </div>
  </div>
</article>
