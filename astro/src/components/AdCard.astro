---
/**
 * Compact listing row (same structure as the leading Kuwait listing sites):
 * 120px tall, photo strip on the start side, one-line title, price + time,
 * two-line description. The whole row is one link.
 */
import type { Ad, Area, Lang } from "@/lib/api";
import { mediaUrl } from "@/lib/api";
import { adHref } from "@/lib/ad-url";
import { adTitle, timeAgo, dict } from "@/lib/i18n";

interface Props { ad: Ad; areas: Area[]; lang: Lang; eager?: boolean; headingLevel?: "h2" | "h3" }
const { ad, areas, lang, eager = false, headingLevel = "h3" } = Astro.props;
const t = dict(lang);
const href = adHref(ad, areas);
const title = adTitle(ad, lang);
const value = Number(ad.price || 0);
const unit = ad.priceUnit === "thousand" ? (lang === "ar" ? "الف" : "K") : lang === "ar" ? "د.ك" : "KD";
const featured = ad.isPremium || ad.premiumAd;
const first = ad.media?.[0];
const img = first ? mediaUrl(first, true) : "";
const excerpt = (ad.description || "").replace(/\s+/g, " ").trim();
const Heading = headingLevel;
---
<article class:list={["group relative isolate flex min-h-[120px] overflow-hidden rounded-[18px] border bg-white transition-shadow hover:shadow-[0_6px_20px_rgba(50,40,37,0.08)]", featured ? "border-brand/25" : "border-line"]}>
  <a href={href} class="absolute inset-0 z-20 rounded-[18px]" aria-label={title} data-astro-prefetch></a>

  <div class="relative w-[92px] shrink-0 bg-[#f1efed]">
    {img ? (
      <img src={img} alt="" width="92" height="120" class="absolute inset-0 size-full object-cover" loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
    ) : (
      <span class="absolute inset-0 flex flex-col items-center justify-center gap-1 text-center">
        <img src="/aqar-new-logo-nav.webp" alt="" width="40" height="26" class="h-auto w-10 opacity-25" loading="lazy" />
        <span class="text-[10px] font-bold text-muted/80">{lang === "ar" ? "بدون صورة" : "No photo"}</span>
      </span>
    )}
    {featured && (
      <span class="absolute top-1.5 start-1.5 z-10 flex items-center gap-[3px] rounded-full bg-white/90 py-[2px] ps-1 pe-1.5 text-[10px] font-bold leading-4 text-brand shadow-[0_1px_4px_rgba(0,0,0,0.15)] backdrop-blur-sm">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 7.5 7.5 11 12 4l4.5 7L21 7.5 19 18H5z"/></svg>
        {t.featured}
      </span>
    )}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center p-2 ps-3 sm:px-[18px] sm:py-2.5">
    <Heading class="truncate text-[16px] font-extrabold leading-[22px] text-ink sm:text-[18px] sm:leading-7">{title}</Heading>
    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="inline-flex items-baseline gap-1">
        {value ? (
          <><span class="text-[16px] font-extrabold text-brand-deep sm:text-[18px]">{value.toLocaleString("en-US")}</span><span class="text-[12px] font-semibold text-muted">{unit}{ad.purpose === "rent" ? ` / ${t.monthly}` : ""}</span></>
        ) : (
          <><span class="text-[14px] font-extrabold text-brand-deep">{t.priceOnRequest}</span>{ad.purpose === "rent" && <span class="text-[12px] font-semibold text-muted"> / {t.monthly}</span>}</>
        )}
      </span>
      <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-muted">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <time datetime={ad.createdAt}>{timeAgo(ad.createdAt, lang)}</time>
      </span>
    </div>
    {excerpt && <p class="mt-1.5 line-clamp-2 text-[12px] leading-[19.5px] text-muted sm:text-[14px] sm:leading-6">{excerpt}</p>}
  </div>
</article>
