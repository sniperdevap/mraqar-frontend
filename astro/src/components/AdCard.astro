---
import type { Ad, Area, Lang } from "@/lib/api";
import { mediaUrl } from "@/lib/api";
import { adHref } from "@/lib/ad-url";
import { adTitle, formatPrice, timeAgo, dict } from "@/lib/i18n";

interface Props { ad: Ad; areas: Area[]; lang: Lang; eager?: boolean; headingLevel?: "h2" | "h3" }
const { ad, areas, lang, eager = false, headingLevel = "h3" } = Astro.props;
const t = dict(lang);
const href = adHref(ad, areas);
const title = adTitle(ad, lang);
const price = formatPrice(ad, lang);
const featured = ad.isPremium || ad.premiumAd;
const first = ad.media?.[0];
const img = mediaUrl(first, true);
const isVideo = first?.type === "video";
const areaName = lang === "ar" ? ad.area?.labelAr : ad.area?.label;
const excerpt = (ad.description || "").replace(/\s+/g, " ").trim();
const Heading = headingLevel;
const purposeLabel = (t as Record<string, string>)[ad.purpose];
---
<a href={href} class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-line transition-shadow hover:shadow-[0_10px_30px_rgba(16,24,40,0.09)]" data-astro-prefetch>
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-canvas">
    <img src={img} alt={title} width="640" height="400" class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
    {featured && <span class="absolute top-3 start-3 rounded-full bg-gold px-3 py-1 text-[12px] font-semibold text-white shadow-sm">{t.featured}</span>}
    <span class="absolute top-3 end-3 rounded-full bg-white/95 px-3 py-1 text-[12px] font-semibold text-ink shadow-sm">{purposeLabel}</span>
    {isVideo && (
      <span class="absolute inset-0 flex items-center justify-center">
        <span class="flex size-12 items-center justify-center rounded-full bg-black/45 text-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg></span>
      </span>
    )}
  </div>
  <article class="flex flex-1 flex-col px-4 pt-3.5 pb-3.5">
    <Heading class="line-clamp-1 text-[15px] font-semibold leading-6 text-ink">{title}</Heading>
    <p class="mt-1.5 text-[17px] font-bold text-brand">
      {price ? <>{price}{ad.purpose === "rent" && <span class="text-[13px] font-medium text-muted"> / {t.monthly}</span>}</> : <span class="text-[14px] font-medium text-muted">{t.priceOnRequest}</span>}
    </p>
    {excerpt && <p class="mt-1.5 mb-3 line-clamp-2 text-[13px] leading-6 text-muted">{excerpt}</p>}
    <p class="mt-auto flex items-center gap-2 border-t border-line/70 pt-3 text-[12.5px] text-muted">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <span class="truncate">{areaName}</span>
      <span aria-hidden="true">·</span>
      <time datetime={ad.createdAt} class="shrink-0">{timeAgo(ad.createdAt, lang)}</time>
      {typeof ad.views === "number" && ad.views > 0 && <span class="ms-auto flex shrink-0 items-center gap-1"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>{ad.views}</span>}
    </p>
  </article>
</a>
