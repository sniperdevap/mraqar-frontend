---
/**
 * Every <head> SEO tag for a page, in one place. Rendered once by Base.astro,
 * so a page can never output two titles, two canonicals or two descriptions.
 *
 * URLs: Arabic is the default at /path, English at /en/path. `path` is the
 * language-free path (with only the query parameters that define the page,
 * e.g. /search?purpose=rent&area=12); tracking parameters are always dropped.
 *
 * Astro escapes every attribute value, and JSON-LD is serialised with "<"
 * escaped so a description can never close the script tag.
 */
import { localePath, type Lang } from "@/lib/i18n";

export interface SeoImage { url: string; width?: number; height?: number; alt?: string }
export interface Props {
  /** Page title without the brand; " | مستر عقار" / " | Mr Aqar" is added unless already present. */
  title: string;
  description: string;
  lang: Lang;
  /** Language-free path for the canonical URL. Defaults to the request path (no query). */
  path?: string;
  /** "noindex" pages keep "follow" so their links still count. */
  noindex?: boolean;
  /** Content exists in Arabic only: canonical is the Arabic URL and no hreflang is output. */
  arOnly?: boolean;
  type?: "website" | "article" | "product";
  image?: SeoImage;
  publishedTime?: string;
  modifiedTime?: string;
  /** Page-specific JSON-LD objects (site-wide Organization/WebSite are added by the layout). */
  jsonLd?: unknown[];
}

const { title, description, lang, path, noindex = false, arOnly = false, type = "website", image, publishedTime, modifiedTime, jsonLd = [] } = Astro.props;
const origin = Astro.site!.origin;
const brand = lang === "ar" ? "مستر عقار" : "Mr Aqar";

const TRACKING = /^(utm_[a-z]+|gclid|fbclid|msclkid|yclid|igshid|ref|_ga|mc_[a-z]+)$/i;
const clean = (raw: string) => {
  const u = new URL(raw, origin);
  [...u.searchParams.keys()].forEach((k) => TRACKING.test(k) && u.searchParams.delete(k));
  const p = u.pathname.length > 1 ? u.pathname.replace(/\/+$/, "") : u.pathname;
  const q = u.searchParams.toString();
  return `${p}${q ? `?${q}` : ""}`;
};
const bare = clean(path || Astro.url.pathname);
const abs = (l: Lang) => new URL(localePath(bare, l), origin).href;
const canonical = abs(arOnly ? "ar" : lang);
const fullTitle = title.includes(brand) || title.includes("مستر عقار") ? title : `${title} | ${brand}`;
const desc = description.replace(/\s+/g, " ").trim().slice(0, 160);
const img: SeoImage = image?.url
  ? { ...image, url: new URL(image.url, origin).href }
  : { url: `${origin}/og-default.jpg`, width: 1200, height: 630, alt: brand };
const robots = noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const ld = (d: unknown) => JSON.stringify(d).replace(/</g, "\\u003c");
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{!noindex && !arOnly && (
  <>
    <link rel="alternate" hreflang="ar-KW" href={abs("ar")} />
    <link rel="alternate" hreflang="en" href={abs("en")} />
    <link rel="alternate" hreflang="x-default" href={abs("ar")} />
  </>
)}
<meta property="og:type" content={type === "product" ? "product" : type} />
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content={lang === "ar" ? "ar_KW" : "en_US"} />
{!arOnly && <meta property="og:locale:alternate" content={lang === "ar" ? "en_US" : "ar_KW"} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={img.url} />
{img.width && <meta property="og:image:width" content={String(img.width)} />}
{img.height && <meta property="og:image:height" content={String(img.height)} />}
{img.alt && <meta property="og:image:alt" content={img.alt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={img.url} />
{img.alt && <meta name="twitter:image:alt" content={img.alt} />}
{jsonLd.map((d) => <script type="application/ld+json" set:html={ld(d)} />)}
