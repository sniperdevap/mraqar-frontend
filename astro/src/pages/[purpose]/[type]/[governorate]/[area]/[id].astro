---
/**
 * SEO ad page: /{purpose}/{type}/{governorate}/{area}/{id}
 * e.g. /rent/apartments/hawalli-governorate/salwa/4071
 */
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import { ApiError, getAd, getAds, getAreas, mediaUrl, countAdView, isFeatured } from "@/lib/api";
import { adHref, findArea, AD_PURPOSES } from "@/lib/ad-url";
import { adTitle, dict, formatPrice, getLang, timeAgo, waNumber } from "@/lib/i18n";
import { adJsonLd } from "@/lib/ad-page";
import { areaGuidePath } from "@/lib/area-guides";
import type { Area } from "@/lib/api";

const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const { purpose, type, governorate, area, id } = Astro.params as Record<string, string>;
if (!AD_PURPOSES.includes(purpose as never) || !/^(\d+|[a-f0-9]{24})$/i.test(id)) return Astro.rewrite("/404");

let ad;
try {
  ad = await getAd(id, lang);
} catch (err) {
  if (err instanceof ApiError && err.status === 404) return Astro.rewrite("/404");
  throw err; // temporary API failure → 500, so Google retries instead of dropping the page
}
const areas = await getAreas(lang).catch(() => []);
const canonical = adHref(ad, areas);
if (canonical !== `/${purpose}/${type}/${governorate}/${area}/${id}` && !canonical.startsWith("/ads/")) {
  return Astro.redirect(canonical, 301);
}

// Count the view without delaying the page.
countAdView(id, Astro.request.headers.get("x-forwarded-for") || undefined);

const site = Astro.site!.origin + (Astro.locals.lang === "en" ? "/en" : "");
const url = `${site}${canonical}`;
const title = adTitle(ad, lang);
const price = formatPrice(ad, lang);
// Many ads share a heading ("شقة للإيجار في سلوى"), so the page title adds the price and ad number.
const seoTitle = lang === "ar"
  ? `${title}${price ? ` بسعر ${price}` : ""} – إعلان ${ad.id}`
  : `${title}${price ? ` for ${price}` : ""} – Ad ${ad.id}`;
const typeQ = ad.propertyType?.id ? `&propertyType=${ad.propertyType.id}` : "";
const crumbs = [
  { name: t.breadcrumbHome, href: "/" },
  { name: (t as Record<string, string>)[ad.purpose], href: `/search?purpose=${ad.purpose}` },
  ...(ad.propertyType ? [{ name: lang === "ar" ? ad.propertyType.labelAr : ad.propertyType.label, href: `/search?purpose=${ad.purpose}${typeQ}` }] : []),
  ...(ad.area?.id ? [{ name: lang === "ar" ? ad.area.labelAr : ad.area.label, href: `/search?purpose=${ad.purpose}${typeQ}&area=${ad.area.id}` }] : []),
];
const guideArea = areas.find((a) => a.id === ad.area?.id) as Area | undefined;
const fullArea = findArea(ad.area, areas) as { governorate?: string; governorateAr?: string } | undefined;
const areaName = lang === "ar" ? ad.area.labelAr : ad.area.label;
const govName = lang === "ar" ? fullArea?.governorateAr : fullArea?.governorate;
const typeName = lang === "ar" ? ad.propertyType?.labelAr : ad.propertyType?.label;
const purposeName = (t as Record<string, string>)[ad.purpose];
const photos = (ad.media || []).map((m) => ({ src: mediaUrl(m), video: m.type === "video" ? mediaUrl({ ...m, type: "image" }) : null, poster: mediaUrl(m, true) }));
const hasPhotos = photos.length > 0;
const ogImage = hasPhotos && photos[0].poster.startsWith("http") ? photos[0].poster : `${Astro.site!.origin}/aqar-new-logo.png`;
// Same rule as the current site: the button shows and dials the advertiser's number,
// or their alternative number when they chose to hide the main one.
const phone = (ad.isPhoneHidden && ad.alternativePhoneNumber ? ad.alternativePhoneNumber : ad.phoneNumber) || ad.user?.phoneNumber || "";
const showNumber = Boolean(phone);
const waText = encodeURIComponent(`${lang === "ar" ? "مرحبًا، أستفسر عن إعلانك في مستر عقار" : "Hello, I'm asking about your ad on Mr Aqar"}\n${title}\n${url}`);
const waLink = phone ? `https://wa.me/${waNumber(phone)}?text=${waText}` : "";
const shareText = encodeURIComponent(`${title} — ${price || ""}`);
const u = encodeURIComponent(url);
const svg = (path: string, vb = "0 0 24 24", size = 26) => `<svg width="${size}" height="${size}" viewBox="${vb}" fill="currentColor" aria-hidden="true">${path}</svg>`;
const shareTargets = [
  { kind: "link", label: t.whatsapp, bg: "#25d366", href: `https://wa.me/?text=${shareText}%0A${u}`, icon: svg('<path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>', "0 0 448 512", 28) },
  { kind: "link", label: "X", bg: "#000000", href: `https://x.com/intent/post?url=${u}&text=${shareText}`, icon: svg('<path d="M18.9 2H22l-7.6 8.7L23.3 22h-7l-5.5-7.2L4.5 22H1.4l8.1-9.3L1 2h7.2l5 6.6zm-1.2 18h1.7L7.4 3.9H5.6z"/>', "0 0 24 24", 22) },
  { kind: "link", label: "Facebook", bg: "#1877f2", href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, icon: svg('<path d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.6.4-1 1-1z"/>', "0 0 24 24", 26) },
  { kind: "link", label: t.telegram, bg: "#29a9eb", href: `https://t.me/share/url?url=${u}&text=${shareText}`, icon: svg('<path d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.5-.6-.2L6.2 13.1 1.4 11.6c-1-.3-1-1 .2-1.5L20.5 2.9c.9-.3 1.6.2 1.4 1.4z"/>', "0 0 24 24", 24) },
  { kind: "link", label: "LinkedIn", bg: "#0a66c2", href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, icon: svg('<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/>', "0 0 24 24", 24) },
  { kind: "link", label: lang === "ar" ? "البريد" : "Email", bg: "#7a7470", href: `mailto:?subject=${encodeURIComponent(title)}&body=${shareText}%0A${u}`, icon: svg('<path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1.4 2 7.6 5.6L19.6 7z"/>', "0 0 24 24", 24) },
  { kind: "copy", label: t.copyLink, bg: "#eceaed", fg: "#322825", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' },
  { kind: "native", label: lang === "ar" ? "المزيد" : "More", bg: "#eceaed", fg: "#322825", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>' },
];
const desc = (ad.description || "").replace(/\s+/g, " ").trim();
// English pages get an English description even when the ad text is Arabic.
const metaArea = areas.find((a) => a.id === ad.area?.id) || fullArea;
const gov = lang === "ar" ? metaArea?.governorateAr : metaArea?.governorate;
const metaDescription = (lang === "en" && /[\u0600-\u06ff]/.test(desc)
  ? `${title}${gov ? `, ${gov}` : ""}, Kuwait${price ? ` — ${price}${ad.purpose === "rent" ? " per month" : ""}` : ""}. Ad #${ad.id}${ad.media?.length ? ` with ${ad.media.length} photo${ad.media.length > 1 ? "s" : ""}` : ""}. Call or WhatsApp the advertiser directly on Mr Aqar.`
  : `${title}${price ? ` — ${price}${ad.purpose === "rent" ? ` ${t.monthly}` : ""}` : ""}. ${desc}`).slice(0, 158);
const sold = ad.status !== "active";
const featured = isFeatured(ad);
const value = Number(ad.price || 0);
const unit = ad.priceUnit === "thousand" ? (lang === "ar" ? "الف" : "K") : lang === "ar" ? "د.ك" : "KD";
// Show the real posted date too, so what Google reads matches what people see.
const postedOn = new Intl.DateTimeFormat(lang === "ar" ? "ar-KW-u-nu-latn" : "en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Kuwait" }).format(new Date(ad.createdAt));

const similar = await getAds({ page: 1, limit: 7, purpose: ad.purpose, propertyType: String(ad.propertyType?.id || ""), status: "active" }, lang)
  .then((r) => r.ads.filter((x) => x.id !== ad.id).slice(0, 6))
  .catch(() => []);

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");
---
<Base title={seoTitle} description={metaDescription} canonical={canonical} image={{ url: ogImage, alt: title }} type="product" publishedTime={ad.createdAt} modifiedTime={ad.createdAt} noindex={sold} jsonLd={adJsonLd(ad, areas, lang, site)} bottomBar={false} back hideFooter>
  <Fragment slot="head">
    {value > 0 && <meta property="product:price:amount" content={String(ad.price)} />}
    {value > 0 && <meta property="product:price:currency" content="KWD" />}
    {hasPhotos && <link rel="preload" as="image" href={photos[0].poster} fetchpriority="high" />}
  </Fragment>

  <article class="mx-auto max-w-[52rem] px-5 pt-4 pb-48">
    <nav class="mb-3 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[12.5px] font-semibold text-muted" aria-label={lang === "ar" ? "مسار التنقل" : "Breadcrumb"}>
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true">›</span>}
          <a href={c.href} class="hover:text-brand">{c.name}</a>
        </>
      ))}
    </nav>
    <header>
      <div class="flex items-start gap-3">
        <h1 class="flex-1 text-[24px] font-extrabold leading-[34px]">{title}</h1>
        <div class="flex shrink-0 gap-2 pt-0.5">
          <button type="button" class="flex size-8 items-center justify-center rounded-full bg-soft text-ink hover:bg-line" aria-label={t.share} data-open="share">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
          </button>
          <a href="/auth/signin" class="flex size-8 items-center justify-center rounded-full bg-soft text-ink hover:bg-line" aria-label={lang === "ar" ? "أضف للمفضلة" : "Save"}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 21s-7-4.4-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12C19 16.6 12 21 12 21z"/></svg>
          </a>
        </div>
      </div>
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold text-muted">
        <span class="inline-flex items-center gap-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <time datetime={ad.createdAt} title={postedOn}>{timeAgo(ad.createdAt, lang)}</time>
        </span>
        <span class="inline-flex items-center gap-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>
          {t.adNo}: {ad.id}
        </span>
        <span class="inline-flex items-center gap-1">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          {(Number(ad.views) || 0).toLocaleString("en-US")} {t.views}
        </span>
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2.5">
        <p class="text-[18px] font-extrabold text-brand-deep">
          {value ? <>{value.toLocaleString("en-US")}<span class="ms-1 text-[14px] font-bold">{unit}</span></> : t.priceOnRequest}
          {ad.purpose === "rent" && <span class="ms-1 text-[15px] font-bold text-muted">/ {t.monthly}</span>}
        </p>
        {featured && (
          <span class="inline-flex items-center gap-1 rounded-full border border-[#e0a83a] bg-gradient-to-l from-[#f7d371] to-[#dc980f] px-2.5 py-0.5 text-[12px] font-extrabold text-[#4a3200]">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.94 14.06A2 2 0 0 0 8.5 12.62L2.37 11.04a.5.5 0 0 1 0-.96L8.5 8.5a2 2 0 0 0 1.44-1.44l1.58-6.13a.5.5 0 0 1 .96 0l1.58 6.13A2 2 0 0 0 15.5 8.5l6.13 1.58a.5.5 0 0 1 0 .96L15.5 12.62a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0z"/></svg>
            {t.featured}
          </span>
        )}
      </div>
    </header>

    <!-- Photos: swipe on phones -->
    <div class="relative mt-4 overflow-hidden rounded-[20px] bg-[#ecebe9]">
      {hasPhotos ? (
        <>
          <div class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]" data-gallery dir="ltr">
            {photos.map((p, i) => (
              <div class="w-full shrink-0 snap-center">
                {p.video ? (
                  <video src={p.video} poster={p.poster} controls playsinline preload="none" class="aspect-[35/24] w-full bg-black object-contain"></video>
                ) : (
                  <img src={p.src} alt={i === 0 ? title : `${title} — ${i + 1}`} width="1050" height="720" class="aspect-[35/24] w-full object-cover" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
                )}
              </div>
            ))}
          </div>
          {photos.length > 1 && <span class="absolute bottom-3 left-3 rounded-full bg-black/60 px-3 py-1 text-[12.5px] font-semibold text-white" dir="ltr" data-gallery-count>1 / {photos.length}</span>}
        </>
      ) : (
        <div class="flex aspect-[35/24] w-full flex-col items-center justify-center gap-2">
          <img src="/aqar-new-logo-nav.webp" alt="" width="80" height="52" class="h-auto w-20 opacity-20" />
          <span class="text-[16px] font-bold text-muted/80">{lang === "ar" ? "بدون صورة" : "No photo"}</span>
        </div>
      )}
    </div>

    {ad.description && <p class="mt-5 whitespace-pre-line text-[15.5px] leading-8 text-ink">{ad.description}</p>}

    <aside class="mt-6 flex gap-2.5 rounded-2xl border border-gold/60 bg-gold-soft/70 p-4 text-[13px] font-bold leading-6 text-[#4a3200]" role="note">
      <svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      <p>{t.safety}</p>
    </aside>

    {ad.user?.name && (
      <a href={ad.user.publicId ? `/offices/${ad.user.publicId}` : "#"} class="mt-4 flex items-center gap-3 rounded-2xl border border-line bg-white p-3.5">
        <span class="flex size-11 items-center justify-center rounded-full bg-brand-soft text-[17px] font-extrabold text-brand-deep">{ad.user.name.trim().charAt(0)}</span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-[15px] font-bold">{ad.user.name}</span>
          <span class="block text-[12.5px] font-semibold text-muted">{t.contactAdvertiser}</span>
        </span>
        <svg class="text-muted rtl:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </a>
    )}

    {ad.area?.id && (
      <nav class="mt-6 flex flex-wrap gap-2" aria-label={lang === "ar" ? "روابط ذات صلة" : "Related links"}>
        <a href={`/search?purpose=${ad.purpose}${typeQ}&area=${ad.area.id}`} class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[13px] font-bold text-ink hover:border-brand hover:text-brand">
          {lang === "ar" ? `${ad.propertyType?.labelAr || "عقارات"} ${t[ad.purpose]} في ${ad.area.labelAr}` : `More ${(ad.propertyType?.label || "property").toLowerCase()} ${t[ad.purpose].toLowerCase()} in ${ad.area.label}`}
        </a>
        <a href={`/search?area=${ad.area.id}`} class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[13px] font-bold text-ink hover:border-brand hover:text-brand">
          {lang === "ar" ? `كل العقارات في ${ad.area.labelAr}` : `All property in ${ad.area.label}`}
        </a>
        {guideArea?.governorate && (
          <a href={areaGuidePath(guideArea)} class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[13px] font-bold text-ink hover:border-brand hover:text-brand">
            {lang === "ar" ? `دليل منطقة ${ad.area.labelAr}` : `${ad.area.label} area guide`}
          </a>
        )}
      </nav>
    )}

    {similar.length > 0 && (
      <section class="mt-9">
        <h2 class="text-[18px] font-extrabold">{t.similar}</h2>
        <div class="mt-3 grid grid-cols-1 gap-2">{similar.map((s) => <AdCard ad={s} areas={areas} lang={lang} />)}</div>
      </section>
    )}
  </article>

  <!-- Fixed contact bar -->
  <div class="pointer-events-none fixed inset-x-0 bottom-0 z-30 bg-gradient-to-t from-canvas via-canvas/90 to-transparent pt-6" style="padding-bottom: env(safe-area-inset-bottom, 0px)">
    <div class="pointer-events-auto mx-auto max-w-[52rem] px-4 pb-2">
      <div class:list={["flex gap-3", !phone && !waLink && "hidden", !phone && "justify-center"]}>
        {phone ? (
          <div class="flex h-10 flex-1 overflow-hidden rounded-xl bg-brand text-white shadow-[0_6px_16px_rgba(217,54,62,0.16)]">
            <a href={`tel:${phone}`} class="flex flex-1 items-center justify-center gap-2 text-[15px] font-bold tracking-wide" dir="ltr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
              {showNumber ? phone.replace(/^\+?965/, "") : <span dir="auto">{lang === "ar" ? "اتصال" : "Call"}</span>}
            </a>
            {showNumber && <button type="button" class="flex w-10 items-center justify-center border-s border-white/30" aria-label={t.copyLink} data-copy={phone.replace(/^\+?965/, "")} data-copied="✓">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>}
          </div>
        ) : null}
        {waLink && (
          <a href={waLink} target="_blank" rel="noopener" class:list={["flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl bg-[#25d366] text-[14px] font-bold text-white", phone ? "w-12" : "flex-1"]} aria-label={t.whatsapp}>
            <svg width="19" height="19" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            {!phone && t.whatsapp}
          </a>
        )}
      </div>
      <button type="button" class="mx-auto mt-1 flex items-center gap-1.5 py-1 text-[12px] font-semibold text-muted hover:text-brand" data-open="report">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 1-1h11l-2 4 2 4H5"/></svg>{t.report}
      </button>
    </div>
  </div>

  <!-- Share sheet -->
  <dialog id="share" class="m-0 mt-auto w-full max-w-none rounded-t-[28px] bg-white p-0 backdrop:bg-black/45 sm:m-auto sm:max-w-md sm:rounded-[28px]" dir={lang === "ar" ? "rtl" : "ltr"} aria-labelledby="share-title">
    <div class="px-5 pt-3 pb-7" style="padding-bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px))">
      <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-line sm:hidden"></div>
      <div class="relative flex h-12 items-center justify-center">
        <p id="share-title" class="text-[20px] font-extrabold">{t.share}</p>
        <form method="dialog" class="absolute end-0"><button class="flex size-10 items-center justify-center rounded-full text-ink/70 hover:bg-soft" aria-label={t.cancel}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button></form>
      </div>
      <div class="mt-4 grid grid-cols-4 gap-x-2 gap-y-5 text-center">
        {shareTargets.map((s) => s.kind === "link" ? (
          <a href={s.href} target="_blank" rel="noopener" class="group flex flex-col items-center gap-2">
            <span class="flex size-14 items-center justify-center rounded-full text-white shadow-sm transition-transform group-active:scale-95" style={`background:${s.bg}`} set:html={s.icon} />
            <span class="text-[13px] font-semibold text-ink">{s.label}</span>
          </a>
        ) : (
          <button type="button" class:list={["group flex flex-col items-center gap-2", s.kind === "native" && "hidden"]} data-share-action={s.kind} data-url={url} data-done={t.copied}>
            <span class="flex size-14 items-center justify-center rounded-full shadow-sm transition-transform group-active:scale-95" style={`background:${s.bg};color:${s.fg}`} set:html={s.icon} />
            <span class="text-[13px] font-semibold text-ink" data-label>{s.label}</span>
          </button>
        ))}
      </div>
    </div>
  </dialog>

  <!-- Report sheet -->
  <dialog id="report" class="m-0 mt-auto w-full max-w-none rounded-t-3xl bg-white p-0 backdrop:bg-black/45 sm:m-auto sm:max-w-md sm:rounded-3xl" dir={lang === "ar" ? "rtl" : "ltr"}>
    <form method="post" action={`/api/report/${ad.id}`} class="space-y-3 p-5 pb-7" data-report>
      <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-line"></div>
      <p class="text-[17px] font-extrabold">{t.report}</p>
      <div class="grid grid-cols-2 gap-2">
        {[["fraud", t.reportFraud], ["wrong", t.reportWrong], ["sold", t.reportSold], ["other", t.reportOther]].map(([v, l], i) => (
          <label class="cursor-pointer"><input type="radio" name="reason" value={v} class="peer sr-only" checked={i === 0} /><span class="flex h-11 items-center justify-center rounded-xl border border-line text-[14px] font-semibold peer-checked:border-brand peer-checked:bg-brand-soft peer-checked:text-brand-deep">{l}</span></label>
        ))}
      </div>
      <textarea name="details" rows="3" maxlength="500" placeholder={t.reportDetails} class="w-full rounded-xl border border-line p-3 text-[16px] outline-none focus:border-brand"></textarea>
      <button class="h-12 w-full rounded-2xl bg-ink text-[15px] font-bold text-white">{t.sendReport}</button>
      <p class="hidden text-center text-[14px] font-semibold text-wa" data-report-done>{t.reportThanks}</p>
    </form>
  </dialog>

  <script>
    const g = document.querySelector<HTMLElement>("[data-gallery]");
    const c = document.querySelector<HTMLElement>("[data-gallery-count]");
    if (g && c) {
      const total = g.children.length;
      g.addEventListener("scroll", () => { c.textContent = `${Math.round(g.scrollLeft / g.clientWidth) + 1} / ${total}`; }, { passive: true });
    }
    document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((b) => b.addEventListener("click", async () => {
      document.querySelector<HTMLDialogElement>(`#${b.dataset.open}`)?.showModal();
    }));
    document.querySelectorAll<HTMLDialogElement>("dialog").forEach((d) => d.addEventListener("click", (e) => { if (e.target === d) d.close(); }));
    // Share sheet: copy link, and "More" opens the phone's own share menu where available.
    document.querySelectorAll<HTMLButtonElement>("[data-share-action]").forEach((b) => {
      const label = b.querySelector<HTMLElement>("[data-label]")!;
      if (b.dataset.shareAction === "native") {
        if (!navigator.share) return;
        b.classList.remove("hidden");
        b.addEventListener("click", () => navigator.share({ title: document.title, url: b.dataset.url! }).catch(() => undefined));
        return;
      }
      b.addEventListener("click", async () => {
        const old = label.textContent;
        try { await navigator.clipboard.writeText(b.dataset.url!); label.textContent = b.dataset.done!; }
        catch { window.prompt("", b.dataset.url!); }
        setTimeout(() => (label.textContent = old), 1800);
      });
    });
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); const old = b.innerHTML; b.textContent = b.dataset.copied!; setTimeout(() => (b.innerHTML = old), 1600); } catch { /* clipboard blocked */ }
    }));
    document.querySelectorAll<HTMLFormElement>("[data-report]").forEach((f) => f.addEventListener("submit", async (e) => {
      e.preventDefault();
      await fetch(f.action, { method: "POST", body: new FormData(f) }).catch(() => undefined);
      f.querySelector("button")!.setAttribute("disabled", "");
      f.querySelector("[data-report-done]")!.classList.remove("hidden");
    }));
  </script>
</Base>
