---
import Base from "@/layouts/Base.astro";
import ar from "@/data/pages.ar.json";
import en from "@/data/pages.en.json";
import { getLang, dict, SUPPORT_PHONE, SUPPORT_WA } from "@/lib/i18n";
const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const c = (lang === "en" ? en : ar).contact;
---
<Base title={c.title} description={c.description} canonical="/contact">
  <div class="mx-auto max-w-xl px-4 pt-8 pb-14">
    <h1 class="text-[28px] font-bold">{c.title}</h1>
    <p class="mt-2 text-[16px] leading-8 text-muted">{c.description}</p>
    <div class="mt-6 space-y-3">
      <a href={SUPPORT_WA} target="_blank" rel="noopener" class="flex h-16 items-center justify-between rounded-2xl bg-white px-5 ring-1 ring-line hover:ring-wa"><span class="text-[16px] font-semibold">{t.whatsapp}</span><span class="text-[15px] text-muted" dir="ltr">{SUPPORT_PHONE}</span></a>
      <a href={`tel:${SUPPORT_PHONE}`} class="flex h-16 items-center justify-between rounded-2xl bg-white px-5 ring-1 ring-line hover:ring-brand"><span class="text-[16px] font-semibold">{t.callNow}</span><span class="text-[15px] text-muted" dir="ltr">{SUPPORT_PHONE}</span></a>
    </div>
  </div>
</Base>
