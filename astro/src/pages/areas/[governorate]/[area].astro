---
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import { getAds, getAreas, getPropertyTypes } from "@/lib/api";
import { getLang, dict } from "@/lib/i18n";
import { governorateSlug, areaSlug } from "@/lib/ad-url";
import { areaGuidePath, areaBlurb } from "@/lib/area-guides";

const lang = getLang(Astro.cookies);
const t = dict(lang);
const { governorate, area: areaParam } = Astro.params;
const [areas, types] = await Promise.all([getAreas(lang).catch(() => []), getPropertyTypes(lang).catch(() => [])]);
if (!areas.length) return new Response(null, { status: 500 });
const area = areas.find((a) => areaSlug(a) === areaParam && governorateSlug(a.governorate) === governorate)
  || areas.find((a) => areaSlug(a) === areaParam && a.governorate);
if (!area) return new Response(null, { status: 404 });
if (governorateSlug(area.governorate) !== governorate) return Astro.redirect(areaGuidePath(area), 301);

const name = lang === "ar" ? area.labelAr : area.label;
const gov = lang === "ar" ? area.governorateAr : area.governorate;
const [rent, sale] = await Promise.all([
  getAds({ limit: 6, purpose: "rent", area: [String(area.id)], status: "active" }, lang).catch(() => null),
  getAds({ limit: 6, purpose: "sale", area: [String(area.id)], status: "active" }, lang).catch(() => null),
]);
const latest = [...(rent?.ads || []), ...(sale?.ads || [])].sort((a, b) => +new Date(b.createdAt) - +new Date(a.createdAt)).slice(0, 6);
const count = (rent?.total || 0) + (sale?.total || 0);
const neighbours = areas.filter((a, i, all) => a.governorate === area.governorate && a.value !== area.value && all.findIndex((b) => b.value === a.value && b.governorate === a.governorate) === i);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=600, stale-while-revalidate=3600");

const typeBy = (v: string) => types.find((x) => x.value === v);
const searches = (["rent", "sale"] as const).flatMap((p) =>
  ([[undefined, "عقارات", "Property"], [typeBy("apartment"), "شقق", "Apartments"], [typeBy("house"), "بيوت", "Houses"], [typeBy("land"), "اراضي", "Land"]] as const).map(([ty, ar, en]) => {
    const s = new URLSearchParams({ purpose: p });
    if (ty) s.set("propertyType", String(ty.id));
    s.append("area", String(area.id));
    return { href: `/search?${s}`, label: lang === "ar" ? `${ar} ${t[p]} في ${name}` : `${en} for ${p} in ${name}` };
  }));

const title = lang === "ar" ? `منطقة ${name}: دليل السكن والعقارات` : `${name}, Kuwait: area guide and property`;
const blurb = areaBlurb(area, lang);
const description = lang === "ar"
  ? `${blurb} تعرّف على منطقة ${name} في ${gov} وتصفح أحدث العقارات للبيع والإيجار فيها على مستر عقار.`.slice(0, 165)
  : `${blurb} Browse the latest property for sale and rent in ${name} on Mr Aqar.`.slice(0, 165);
const site = Astro.site!.origin;
const path = areaGuidePath(area);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: t.breadcrumbHome, item: site },
    { "@type": "ListItem", position: 2, name: lang === "ar" ? "دليل المناطق" : "Areas", item: `${site}/areas` },
    { "@type": "ListItem", position: 3, name: gov, item: `${site}/areas#${governorateSlug(area.governorate)}` },
    { "@type": "ListItem", position: 4, name, item: `${site}${path}` } ] },
  { "@context": "https://schema.org", "@type": "Place", name, description: blurb, url: `${site}${path}`,
    address: { "@type": "PostalAddress", addressLocality: name, addressRegion: gov, addressCountry: "KW" },
    containedInPlace: { "@type": "AdministrativeArea", name: gov } },
];
---
<Base title={title} description={description} canonical={path} jsonLd={jsonLd} active="blog">
  <div class="mx-auto max-w-[52rem] px-5 pt-6 pb-12">
    <nav class="text-[12.5px] font-semibold text-muted" aria-label="breadcrumb">
      <a href="/" class="hover:text-brand">{t.breadcrumbHome}</a> <span aria-hidden="true">›</span>
      <a href="/areas" class="hover:text-brand">{lang === "ar" ? "دليل المناطق" : "Areas"}</a> <span aria-hidden="true">›</span>
      <a href={`/areas#${governorateSlug(area.governorate)}`} class="hover:text-brand">{gov}</a>
    </nav>

    <header class="mt-3 overflow-hidden rounded-[22px] border border-line bg-gradient-to-bl from-white to-soft p-5">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[12px] font-bold text-muted shadow-[0_1px_4px_rgba(0,0,0,0.06)]">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        {gov}
      </span>
      <h1 class="mt-3 text-[24px] font-extrabold leading-9">{title}</h1>
      <p class="mt-2 text-[15px] leading-8 text-ink/90">{blurb}</p>
      <p class="mt-3 text-[13px] font-semibold text-muted">{count.toLocaleString("en-US")} {lang === "ar" ? "إعلان نشط في المنطقة" : "active listings here"}</p>
    </header>

    <section class="mt-6" aria-labelledby="about-area">
      <h2 id="about-area" class="text-[18px] font-extrabold">{lang === "ar" ? `العنوان والخدمات في ${name}` : `Addresses and services in ${name}`}</h2>
      <ul class="mt-3 space-y-2.5 text-[14.5px] leading-7 text-ink/90">
        <li class="flex gap-2"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand"></span>{lang === "ar" ? `يُكتب العنوان في ${name} بالترتيب: المنطقة، ثم القطعة، ثم الشارع، ثم رقم المنزل أو العمارة. وبعض المناطق تستخدم «الجادة» أيضًا.` : `Addresses in ${name} run area, block, street, then house or building number. Some areas also use a jadda (lane).`}</li>
        <li class="flex gap-2"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand"></span>{lang === "ar" ? "الجمعية التعاونية هي مركز الحي اليومي حيث توجد: البقالة ولوحة الإعلانات وبعض المحلات." : "Where there is one, the co-op is the day-to-day centre: groceries, a noticeboard and a few shops."}</li>
        <li class="flex gap-2"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand"></span>{lang === "ar" ? "اطلب من المعلن رقم القطعة والدور والمساحة قبل المعاينة، وجرّب الطريق إلى عملك وقت الذروة." : "Ask the advertiser for the block, floor and size before viewing, and try the drive to work at rush hour."}</li>
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="area-latest">
      <div class="flex items-end justify-between gap-3">
        <h2 id="area-latest" class="text-[18px] font-extrabold">{lang === "ar" ? `أحدث العقارات في ${name}` : `Latest property in ${name}`}</h2>
        <a href={`/search?area=${area.id}`} class="shrink-0 text-[13px] font-bold text-brand">{t.showMore}</a>
      </div>
      {latest.length ? (
        <div class="mt-3 grid grid-cols-1 gap-2">{latest.map((ad) => <AdCard ad={ad} areas={areas} lang={lang} />)}</div>
      ) : (
        <p class="mt-3 rounded-[18px] border border-dashed border-line bg-white p-8 text-center text-[14px] text-muted">
          {lang === "ar" ? `لا توجد إعلانات في ${name} حاليًا.` : `No listings in ${name} right now.`}
          <a href="/ads/create" class="ms-1 font-bold text-brand">{lang === "ar" ? "أضف إعلانك مجانًا" : "Post your ad for free"}</a>
        </p>
      )}
    </section>

    <section class="mt-8 rounded-[18px] border border-line bg-white p-5 shadow-[0_2px_10px_rgba(50,40,37,0.05)]" aria-labelledby="area-searches">
      <h2 id="area-searches" class="flex items-center gap-2 text-[16px] font-extrabold"><span class="h-5 w-1 rounded-full bg-brand" aria-hidden="true"></span>{lang === "ar" ? `ابحث في ${name}` : `Search ${name}`}</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5">
        {searches.map((s) => <li class="min-w-0"><a href={s.href} class="text-[13.5px] text-muted hover:text-brand">{s.label}</a></li>)}
      </ul>
    </section>

    {neighbours.length > 0 && (
      <section class="mt-8" aria-labelledby="area-more">
        <h2 id="area-more" class="text-[18px] font-extrabold">{lang === "ar" ? `مناطق أخرى في ${gov}` : `More areas in ${gov}`}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {neighbours.map((a) => <a href={areaGuidePath(a)} class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[13px] font-semibold text-ink hover:border-brand hover:text-brand">{lang === "ar" ? a.labelAr : a.label}</a>)}
        </div>
      </section>
    )}
  </div>
</Base>
