---
import Base from "@/layouts/Base.astro";
import { getAreas } from "@/lib/api";
import { getLang, dict } from "@/lib/i18n";
import { areaGuidePath, byGovernorate } from "@/lib/area-guides";

const lang = getLang(Astro.cookies);
const t = dict(lang);
const areas = await getAreas(lang).catch(() => []);
if (!areas.length) return new Response(null, { status: 500 });
const groups = byGovernorate(areas);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400");

const title = lang === "ar" ? "دليل مناطق الكويت" : "Kuwait areas guide";
const description = lang === "ar"
  ? `دليل ${areas.length} منطقة في محافظات الكويت الست: نبذة عن كل منطقة، وأحدث عقاراتها للبيع والإيجار على مستر عقار.`
  : `A guide to ${areas.length} areas across Kuwait's six governorates, with the latest property for sale and rent in each on Mr Aqar.`;
const site = Astro.site!.origin;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: t.breadcrumbHome, item: site },
    { "@type": "ListItem", position: 2, name: title, item: `${site}/areas` } ] },
  { "@context": "https://schema.org", "@type": "CollectionPage", name: title, url: `${site}/areas`, inLanguage: lang === "ar" ? "ar-KW" : "en" },
];
---
<Base title={title} description={description} canonical="/areas" jsonLd={jsonLd} active="blog">
  <div class="mx-auto max-w-[52rem] px-5 pt-6 pb-12">
    <nav class="text-[12.5px] font-semibold text-muted" aria-label="breadcrumb"><a href="/" class="hover:text-brand">{t.breadcrumbHome}</a> <span aria-hidden="true">›</span> <a href="/blog" class="hover:text-brand">{t.blog}</a></nav>
    <h1 class="mt-2 text-[24px] font-extrabold leading-9">{title}</h1>
    <p class="mt-1.5 text-[14px] leading-7 text-muted">
      {lang === "ar"
        ? "تنقسم الكويت إلى ست محافظات، ويستخدم الناس اسم المنطقة لا المحافظة عند ذكر العنوان. كل منطقة مقسمة إلى قطع مرقمة، ثم شوارع. اختر منطقة لتقرأ عنها وتتصفح عقاراتها."
        : "Kuwait has six governorates, and people give addresses by area, not governorate. Each area is split into numbered blocks, then streets. Pick an area to read about it and browse its listings."}
    </p>

    <nav class="-mx-5 mt-5 flex gap-2 overflow-x-auto px-5 pb-1 [scrollbar-width:none]" aria-label={lang === "ar" ? "المحافظات" : "Governorates"}>
      {groups.map((g) => <a href={`#${g.slug}`} class="shrink-0 rounded-full border border-line bg-white px-4 py-2 text-[13px] font-bold text-ink hover:border-brand hover:text-brand">{lang === "ar" ? g.govAr : g.gov}</a>)}
    </nav>

    <div class="mt-6 space-y-5">
      {groups.map((g) => (
        <section id={g.slug} class="scroll-mt-24 rounded-[18px] border border-line bg-white p-5 shadow-[0_2px_10px_rgba(50,40,37,0.05)]">
          <h2 class="flex items-center gap-2 text-[17px] font-extrabold">
            <span class="h-5 w-1 rounded-full bg-brand" aria-hidden="true"></span>
            {lang === "ar" ? g.govAr : g.gov}
            <span class="text-[12.5px] font-semibold text-muted">· {g.areas.length} {lang === "ar" ? "منطقة" : "areas"}</span>
          </h2>
          <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 sm:grid-cols-3">
            {g.areas.map((a) => (
              <li class="min-w-0"><a href={areaGuidePath(a)} class="block truncate text-[14px] font-semibold text-ink hover:text-brand">{lang === "ar" ? a.labelAr : a.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
