---
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import SearchForm from "@/components/SearchForm.astro";
import { getAds, getAreas, getPropertyTypes } from "@/lib/api";
import { getLang, dict } from "@/lib/i18n";

const lang = getLang(Astro.cookies);
const t = dict(lang);
const [areas, types, latest] = await Promise.all([
  getAreas(lang).catch(() => []),
  getPropertyTypes(lang).catch(() => []),
  getAds({ page: 1, limit: 12, status: "active" }, lang).catch(() => null),
]);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=120");

const title = lang === "ar" ? "مستر عقار | عقارات الكويت للبيع والإيجار والبدل" : "Mr Aqar | Kuwait property for sale, rent and exchange";
const description = lang === "ar"
  ? "ابحث في آلاف العقارات في الكويت للبيع والإيجار والبدل: شقق، بيوت، أراضٍ، عمارات وشاليهات. أضف إعلانك مجانًا عبر مستر عقار."
  : "Search thousands of properties in Kuwait for sale, rent and exchange: apartments, houses, land, buildings and chalets. Post your ad for free on Mr Aqar.";
---
<Base title={title} description={description} canonical="/" active="home">
  <section class="relative overflow-hidden bg-canvas">
        <div class="relative mx-auto max-w-xl px-5 pt-9 pb-10 sm:pt-14">
      <h1 class="text-center text-[28px] font-bold leading-[1.45] sm:text-[34px]">{t.heroTitle}</h1>
      <p class="mx-auto mt-3 max-w-lg text-center text-[15.5px] leading-7 text-ink-2">{t.heroSub}</p>
      <div class="mt-7"><SearchForm lang={lang} areas={areas} types={types} /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12 sm:px-6">
    <div class="mb-4 flex items-end justify-between">
      <h2 class="text-[18px] font-bold">{t.latest}</h2>
      <a href="/search" class="text-[14.5px] font-semibold text-brand">{t.showMore}</a>
    </div>
    {latest?.ads.length ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {latest.ads.map((ad, i) => <AdCard ad={ad} areas={areas} lang={lang} eager={i < 2} />)}
      </div>
    ) : <p class="rounded-2xl border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}
    <a href="/search" class="mx-auto mt-8 flex h-13 max-w-sm items-center justify-center rounded-xl border border-brand text-[15.5px] font-semibold text-brand hover:bg-brand-soft">{t.showMore}</a>
  </section>
</Base>
