---
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import SearchForm from "@/components/SearchForm.astro";
import { getAds, getAreas, getPropertyTypes } from "@/lib/api";
import { getLang, dict, adTitle } from "@/lib/i18n";
import { adHref } from "@/lib/ad-url";

const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const [areas, types, latest] = await Promise.all([
  getAreas(lang).catch(() => []),
  getPropertyTypes(lang).catch(() => []),
  getAds({ page: 1, limit: 12, status: "active" }, lang).catch(() => null),
]);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=120");

const title = lang === "ar" ? "مستر عقار | عقارات للبيع والإيجار والبدل في الكويت" : "Mr Aqar | Property for sale, rent and exchange in Kuwait";
const description = lang === "ar"
  ? "شقق وبيوت وأراضٍ وعمارات وشاليهات للبيع والإيجار والبدل في كل مناطق الكويت. تواصل مباشرة مع الملاك والمكاتب، وأضف إعلانك مجانًا على مستر عقار."
  : "Apartments, houses, land, buildings and chalets for sale, rent and exchange across Kuwait. Contact owners and offices directly, and post your ad free on Mr Aqar.";
const site = Astro.site!.origin + (lang === "en" ? "/en" : "");
// The newest listings, as an ItemList (each item points at its own ad page).
const jsonLd = latest?.ads.length ? [{
  "@context": "https://schema.org", "@type": "ItemList", name: lang === "ar" ? "أحدث إعلانات العقارات في الكويت" : "Latest property ads in Kuwait",
  itemListElement: latest.ads.map((ad, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}${adHref(ad, areas)}`, name: adTitle(ad, lang) })),
}] : [];
---
<Base title={title} description={description} canonical="/" jsonLd={jsonLd} active="home">
  <section class="relative overflow-hidden bg-gradient-to-b from-white to-canvas">
        <div class="relative mx-auto max-w-lg px-5 pt-8 pb-8 sm:pt-12">
      <p class="mx-auto mb-4 flex w-fit items-center gap-1.5 rounded-full border border-line bg-white px-3.5 py-1.5 text-[12.5px] font-bold text-ink shadow-[0_4px_14px_rgba(50,40,37,0.06)]">
        <svg class="text-brand" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.94 14.06A2 2 0 0 0 8.5 12.62L2.37 11.04a.5.5 0 0 1 0-.96L8.5 8.5a2 2 0 0 0 1.44-1.44l1.58-6.13a.5.5 0 0 1 .96 0l1.58 6.13A2 2 0 0 0 15.5 8.5l6.13 1.58a.5.5 0 0 1 0 .96L15.5 12.62a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0z"/><path d="M19 3v4M17 5h4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
        {lang === "ar" ? "مدعوم بتقنيات الذكاء الاصطناعي" : "Powered by AI technology"}
      </p>
      <h1 class="text-center text-[24px] font-extrabold leading-[30px] sm:text-[32px] sm:leading-[42px]">{t.heroTitle}</h1>
      <p class="mx-auto mt-2 max-w-lg text-center text-[14px] leading-6 text-muted">{t.heroSub}</p>
      <div class="mt-6"><SearchForm lang={lang} areas={areas} types={types} /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-6 pb-12">
    <h2 class="text-center text-[20px] font-extrabold md:text-[24px]">{lang === "ar" ? "أحدث إعلانات العقارات" : "Latest property ads"}</h2>
    <div class="mx-auto mt-2 h-1 w-16 rounded-full bg-brand" aria-hidden="true"></div>
    <div class="mt-6">
      {latest?.ads.length ? (
        <div class="mx-auto grid w-full min-w-0 max-w-[52rem] grid-cols-1 gap-2">
          {latest.ads.map((ad, i) => <AdCard ad={ad} areas={areas} lang={lang} eager={i < 3} />)}
        </div>
      ) : <p class="mx-auto max-w-[52rem] rounded-[18px] border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}
    </div>
    <div class="mt-6 text-center">
      <a href="/search" class="inline-flex h-12 items-center rounded-full bg-soft px-7 text-[15px] font-bold text-ink hover:bg-line">{t.showMore}</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-14">
    <a href="/areas" class="mx-auto flex max-w-[52rem] items-center gap-3 rounded-[18px] border border-line bg-white p-4 shadow-[0_2px_10px_rgba(50,40,37,0.06)] hover:border-brand lg:max-w-none">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
      <span class="min-w-0 flex-1"><span class="block text-[15px] font-extrabold text-ink">{lang === "ar" ? "دليل مناطق الكويت" : "Kuwait areas guide"}</span><span class="block text-[12.5px] text-muted">{lang === "ar" ? "نبذة عن كل منطقة في المحافظات الست وأحدث عقاراتها" : "Every area in the six governorates, with its latest listings"}</span></span>
      <svg class="shrink-0 text-muted rtl:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
    </a>
  </section>
</Base>
