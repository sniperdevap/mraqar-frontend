---
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import SearchForm from "@/components/SearchForm.astro";
import { getAds, getAreas, getPropertyTypes } from "@/lib/api";
import { getLang, dict } from "@/lib/i18n";

const lang = getLang(Astro.cookies);
const t = dict(lang);
const [areas, types, latest] = await Promise.all([
  getAreas(lang).catch(() => []),
  getPropertyTypes(lang).catch(() => []),
  getAds({ page: 1, limit: 12, status: "active" }, lang).catch(() => null),
]);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=120");

const title = lang === "ar" ? "مستر عقار | عقارات الكويت للبيع والإيجار والبدل" : "Mr Aqar | Kuwait property for sale, rent and exchange";
const description = lang === "ar"
  ? "ابحث في آلاف العقارات في الكويت للبيع والإيجار والبدل: شقق، بيوت، أراضٍ، عمارات وشاليهات. أضف إعلانك مجانًا عبر مستر عقار."
  : "Search thousands of properties in Kuwait for sale, rent and exchange: apartments, houses, land, buildings and chalets. Post your ad for free on Mr Aqar.";
---
<Base title={title} description={description} canonical="/" active="home">
  <section class="relative overflow-hidden bg-gradient-to-b from-white to-canvas">
        <div class="relative mx-auto max-w-lg px-5 pt-8 pb-8 sm:pt-12">
      <a href="/auth/signin?next=/ads/create" class="mx-auto mb-4 flex w-fit items-center gap-2 rounded-full border border-gold/60 bg-gold-soft px-4 py-2 text-[13px] font-bold text-[#4a3200] shadow-[0_4px_14px_rgba(212,154,57,0.18)] transition-transform hover:-translate-y-px">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-gold" aria-hidden="true"><path d="M9.94 14.06A2 2 0 0 0 8.5 12.62L2.37 11.04a.5.5 0 0 1 0-.96L8.5 8.5a2 2 0 0 0 1.44-1.44l1.58-6.13a.5.5 0 0 1 .96 0l1.58 6.13a2 2 0 0 0 1.44 1.44l6.13 1.58a.5.5 0 0 1 0 .96l-6.13 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0z"/></svg>
        {lang === "ar" ? "منصة عقارية كويتية · أضف إعلانك مجانًا" : "A Kuwaiti property platform · Post your ad for free"}
      </a>
      <h1 class="text-center text-[24px] font-extrabold leading-[30px] sm:text-[32px] sm:leading-[42px]">{t.heroTitle}</h1>
      <p class="mx-auto mt-2 max-w-lg text-center text-[14px] leading-6 text-muted">{t.heroSub}</p>
      <div class="mt-6"><SearchForm lang={lang} areas={areas} types={types} /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-6 pb-12">
    <h2 class="text-center text-[20px] font-extrabold md:text-[24px]">{lang === "ar" ? "أحدث إعلانات العقارات" : "Latest property ads"}</h2>
    <div class="mx-auto mt-2 h-1 w-16 rounded-full bg-brand" aria-hidden="true"></div>
    <div class="mt-6">
      {latest?.ads.length ? (
        <div class="mx-auto grid w-full min-w-0 max-w-[52rem] grid-cols-1 gap-2">
          {latest.ads.map((ad, i) => <AdCard ad={ad} areas={areas} lang={lang} eager={i < 3} />)}
        </div>
      ) : <p class="mx-auto max-w-[52rem] rounded-[18px] border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}
    </div>
    <div class="mt-6 text-center">
      <a href="/search" class="inline-flex h-12 items-center rounded-full bg-soft px-7 text-[15px] font-bold text-ink hover:bg-line">{t.showMore}</a>
    </div>
  </section>
</Base>
