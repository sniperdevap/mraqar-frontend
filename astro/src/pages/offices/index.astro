---
import Base from "@/layouts/Base.astro";
import OfficeAvatar from "@/components/OfficeAvatar.astro";
import { getOffices } from "@/lib/api";
import { getLang, dict, waNumber } from "@/lib/i18n";

const lang = getLang(Astro.cookies);
const t = dict(lang);
const search = (Astro.url.searchParams.get("search") || "").trim();
const page = Math.max(1, Number(Astro.url.searchParams.get("page") || 1));
const data = await getOffices({ page, limit: 24, search: search || undefined }, lang).catch(() => null);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=120, stale-while-revalidate=600");

const title = lang === "ar" ? "المكاتب العقارية في الكويت" : "Real estate offices in Kuwait";
const description = lang === "ar"
  ? "دليل المكاتب العقارية والوسطاء في الكويت: تصفح إعلانات كل مكتب وتواصل معهم مباشرة عبر الاتصال أو واتساب على مستر عقار."
  : "Directory of real estate offices and brokers in Kuwait: browse each office's ads and contact them directly by phone or WhatsApp on Mr Aqar.";
const site = Astro.site!.origin;
const jsonLd = data ? [{
  "@context": "https://schema.org", "@type": "ItemList", name: title,
  itemListElement: data.offices.map((o, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}/offices/${o.publicId}`, name: o.name })),
}] : [];
const pageHref = (p: number) => `/offices?${new URLSearchParams({ ...(search ? { search } : {}), ...(p > 1 ? { page: String(p) } : {}) })}`;
---
<Base title={title} description={description} canonical={page > 1 ? `/offices?page=${page}` : "/offices"} noindex={Boolean(search)} jsonLd={jsonLd} active="offices">
  <section class="border-b border-line bg-white">
    <div class="mx-auto max-w-4xl px-4 pt-7 pb-6">
      <h1 class="text-[26px] font-bold">{t.officesTitle}</h1>
      <p class="mt-1.5 text-[15px] leading-7 text-muted">{t.officesSub}</p>
      <form method="get" action="/offices" class="mt-5 flex gap-2" role="search">
        <label class="relative flex-1">
          <span class="sr-only">{t.searchOffices}</span>
          <svg class="pointer-events-none absolute start-3.5 top-1/2 -translate-y-1/2 text-gray-400" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="search" value={search} placeholder={t.searchOffices} class="h-13 w-full rounded-xl bg-canvas ps-11 pe-4 text-[16px] ring-1 ring-line outline-none focus:bg-white focus:ring-brand" />
        </label>
        <button class="h-13 rounded-xl bg-brand px-5 text-[15px] font-semibold text-white hover:bg-brand-dark">{t.search}</button>
      </form>
      {data && <p class="mt-3 text-[14px] text-muted">{data.total.toLocaleString("en-US")} {lang === "ar" ? "مكتب" : "offices"}</p>}
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-6">
    {data?.offices.length ? (
      <ul class="grid gap-3.5 md:grid-cols-2">
        {data.offices.map((o) => {
          const wa = waNumber(o.phoneNumber);
          return (
            <li class="rounded-2xl bg-white p-4 ring-1 ring-line transition-shadow hover:shadow-[0_8px_24px_rgba(16,24,40,0.07)]">
              <a href={`/offices/${o.publicId}`} class="flex items-center gap-3.5">
                <OfficeAvatar name={o.name} avatar={o.avatar} />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[16.5px] font-bold text-ink">{o.name}</span>
                  <span class="mt-0.5 block text-[13.5px] text-muted">{(o.adsCount ?? 0).toLocaleString("en-US")} {t.adsCount}</span>
                </span>
                <svg class="shrink-0 text-gray-300 rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
              </a>
              {o.phoneNumber && (
                <div class="mt-3.5 grid grid-cols-2 gap-2.5 border-t border-line pt-3.5">
                  <a href={`tel:${o.phoneNumber}`} class="flex h-11 items-center justify-center gap-2 rounded-xl bg-canvas text-[14.5px] font-medium text-ink hover:bg-brand-soft">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{t.callNow}
                  </a>
                  <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener" class="flex h-11 items-center justify-center gap-2 rounded-xl bg-wa/10 text-[14.5px] font-medium text-wa hover:bg-wa/15">
                    <svg width="17" height="17" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157z"/></svg>{t.whatsapp}
                  </a>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    ) : <p class="rounded-2xl border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}

    {data && data.totalPages > 1 && (
      <nav class="mt-7 flex items-center justify-center gap-2">
        {page > 1 && <a href={pageHref(page - 1)} rel="prev" class="flex h-11 items-center rounded-xl bg-white px-4 ring-1 ring-line">{t.prev}</a>}
        <span class="px-3 text-[14px] text-muted">{t.page} {page} / {data.totalPages}</span>
        {page < data.totalPages && <a href={pageHref(page + 1)} rel="next" class="flex h-11 items-center rounded-xl bg-white px-4 ring-1 ring-line">{t.next}</a>}
      </nav>
    )}
  </div>
</Base>
