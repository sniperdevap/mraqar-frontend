---
import Base from "@/layouts/Base.astro";
import { getOffices, IMAGE_HOST } from "@/lib/api";
import { getLang, dict, waNumber } from "@/lib/i18n";

const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const search = (Astro.url.searchParams.get("search") || "").trim();
const page = Math.max(1, Number(Astro.url.searchParams.get("page") || 1));
const data = await getOffices({ page, limit: 24, search: search || undefined }, lang).catch(() => null);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=120, stale-while-revalidate=600");

const title = lang === "ar" ? "قائمة المكاتب العقارية في الكويت" : "Real estate offices in Kuwait";
const description = lang === "ar"
  ? "دليل المكاتب العقارية والوسطاء في الكويت: تصفح إعلانات كل مكتب وتواصل معهم مباشرة عبر الاتصال أو واتساب على مستر عقار."
  : "Directory of real estate offices and brokers in Kuwait: browse each office's ads and contact them directly by phone or WhatsApp on Mr Aqar.";
const site = Astro.site!.origin + (Astro.locals.lang === "en" ? "/en" : "");
const jsonLd = data ? [{
  "@context": "https://schema.org", "@type": "ItemList", name: title,
  itemListElement: data.offices.map((o, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}/offices/${o.publicId}`, name: o.name })),
}] : [];
const crumbsLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: t.breadcrumbHome, item: site },
  { "@type": "ListItem", position: 2, name: t.offices, item: `${site}/offices` } ] };
jsonLd.push(crumbsLd as any);
const igUrl = (h?: string) => !h ? "" : h.startsWith("http") ? h : `https://instagram.com/${h.replace(/^@/, "")}`;
const ttUrl = (h?: string) => !h ? "" : h.startsWith("http") ? h : `https://www.tiktok.com/@${h.replace(/^@/, "")}`;
type OfficeLink = { href: string; label: string; cls: string; icon: string; vb: string; fill?: boolean };
const officeLinks = (o: { instagram?: string; tiktok?: string }, wa: string): OfficeLink[] => [
            wa && { href: `https://wa.me/${wa}`, label: "WhatsApp", cls: "text-[#25d366]", icon: '<path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157z"/>', vb: "0 0 448 512", fill: true },
            o.instagram && { href: igUrl(o.instagram), label: "Instagram", cls: "text-[#d62976]", icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>', vb: "0 0 24 24" },
            o.tiktok && { href: ttUrl(o.tiktok), label: "TikTok", cls: "text-ink", icon: '<path d="M16 3c.4 2.6 2 4.2 4.5 4.5v3.2c-1.7 0-3.2-.5-4.5-1.4V15a6 6 0 1 1-6-6v3.3a2.7 2.7 0 1 0 2.7 2.7V3z"/>', vb: "0 0 24 24", fill: true },
          ].filter(Boolean) as OfficeLink[];
const pages = (() => {
  const total = data?.totalPages || 1, out: Array<number | "…"> = [];
  for (let p = 1; p <= total; p++) {
    if (p === 1 || p === total || Math.abs(p - page) <= 1) out.push(p);
    else if (out[out.length - 1] !== "…") out.push("…");
  }
  return out;
})();
const imgSrc = (a?: string) => (!a ? "" : a.startsWith("http") ? a : `${IMAGE_HOST}/${a.replace(/^\/+/, "")}`);
const pageHref = (p: number) => `/offices?${new URLSearchParams({ ...(search ? { search } : {}), ...(p > 1 ? { page: String(p) } : {}) })}`;
---
<Base title={title} description={description} canonical={page > 1 ? `/offices?page=${page}` : "/offices"} noindex={Boolean(search)} jsonLd={jsonLd} active="offices">
  <div class="mx-auto max-w-5xl px-4 pt-6 pb-12">
    <h1 class="text-[22px] font-extrabold leading-8 md:text-[26px]">
      {lang === "ar" ? "قائمة المكاتب" : "Offices"} {data && <span class="text-muted">({data.total.toLocaleString("en-US")})</span>}
    </h1>

    <form method="get" action="/offices" class="mt-4 rounded-2xl border border-line bg-white p-3.5" role="search">
      <p class="mb-2 text-[14px] font-bold">{lang === "ar" ? "بحث عن مكتب" : "Find an office"}</p>
      <div class="flex gap-2">
        <input type="search" name="search" value={search} placeholder={lang === "ar" ? "إسم المكتب" : "Office name"} aria-label={lang === "ar" ? "إسم المكتب" : "Office name"} class="h-11 min-w-0 flex-1 rounded-xl border border-line bg-white px-3.5 text-[15px] outline-none focus:border-brand" />
        <button class="h-11 shrink-0 rounded-xl bg-brand px-5 text-[14.5px] font-bold text-white hover:bg-brand-dark">{t.search}</button>
      </div>
    </form>

    {data && data.totalPages > 1 && (
      <nav class="mt-4 flex flex-wrap items-center justify-center gap-1.5" aria-label={t.page}>
        {page > 1 && <a href={pageHref(page - 1)} rel="prev" class="flex size-9 items-center justify-center rounded-lg border border-line bg-white text-[16px] font-bold" aria-label={t.prev}>‹</a>}
        {pages.map((p) => p === "…" ? <span class="px-1 text-muted">…</span> : (
          <a href={pageHref(p)} aria-current={p === page ? "page" : undefined} class:list={["flex h-9 min-w-9 items-center justify-center rounded-lg border px-2 text-[14px] font-bold", p === page ? "border-brand bg-brand text-white" : "border-line bg-white text-ink hover:border-brand"]}>{p}</a>
        ))}
        {page < data.totalPages && <a href={pageHref(page + 1)} rel="next" class="flex size-9 items-center justify-center rounded-lg border border-line bg-white text-[16px] font-bold" aria-label={t.next}>›</a>}
      </nav>
    )}

    {data?.offices.length ? (
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {data.offices.map((o) => {
          const wa = o.phoneNumber ? waNumber(o.phoneNumber) : "";
          const src = imgSrc(o.avatar);
          const links = officeLinks(o, wa);
          return (
            <li class="relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-shadow hover:shadow-[0_6px_20px_rgba(50,40,37,0.08)]">
              <a href={`/offices/${o.publicId}`} class="flex aspect-square items-center justify-center bg-white p-4" aria-label={o.name}>
                {src ? (
                  <img src={src} alt={o.name} width="240" height="240" loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
                ) : (
                  <span class="flex size-20 items-center justify-center rounded-2xl bg-soft text-[30px] font-extrabold text-muted">{o.name.trim().charAt(0)}</span>
                )}
              </a>
              <div class="flex flex-1 flex-col items-center border-t border-line px-2.5 pt-2.5 pb-3 text-center">
                <h2 class="line-clamp-2 text-[14.5px] font-extrabold leading-6"><a href={`/offices/${o.publicId}`} class="hover:text-brand">{o.name}</a></h2>
                <div class="mt-auto flex items-center justify-center gap-1.5 pt-2.5">
                  {o.phoneNumber && (
                    <a href={`tel:${o.phoneNumber}`} aria-label={`${t.callNow} ${o.name}`} class="flex size-9 items-center justify-center rounded-full bg-brand text-white">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
                    </a>
                  )}
                  {links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener nofollow" aria-label={`${o.name} ${l.label}`} class:list={["flex size-9 items-center justify-center rounded-full bg-soft hover:bg-line", l.cls]}>
                      <svg width="16" height="16" viewBox={l.vb} fill={l.fill ? "currentColor" : "none"} stroke={l.fill ? "none" : "currentColor"} stroke-width="2" aria-hidden="true" set:html={l.icon} />
                    </a>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    ) : <p class="mt-4 rounded-2xl border border-dashed border-line bg-white p-10 text-center text-muted">{lang === "ar" ? "لا توجد مكاتب مطابقة." : "No matching offices."}</p>}

    {data && data.totalPages > 1 && (
      <nav class="mt-4 flex flex-wrap items-center justify-center gap-1.5" aria-label={t.page}>
        {page > 1 && <a href={pageHref(page - 1)} rel="prev" class="flex size-9 items-center justify-center rounded-lg border border-line bg-white text-[16px] font-bold" aria-label={t.prev}>‹</a>}
        {pages.map((p) => p === "…" ? <span class="px-1 text-muted">…</span> : (
          <a href={pageHref(p)} aria-current={p === page ? "page" : undefined} class:list={["flex h-9 min-w-9 items-center justify-center rounded-lg border px-2 text-[14px] font-bold", p === page ? "border-brand bg-brand text-white" : "border-line bg-white text-ink hover:border-brand"]}>{p}</a>
        ))}
        {page < data.totalPages && <a href={pageHref(page + 1)} rel="next" class="flex size-9 items-center justify-center rounded-lg border border-line bg-white text-[16px] font-bold" aria-label={t.next}>›</a>}
      </nav>
    )}
  </div>
</Base>
