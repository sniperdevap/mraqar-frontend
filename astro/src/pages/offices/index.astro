---
import Base from "@/layouts/Base.astro";
import OfficeAvatar from "@/components/OfficeAvatar.astro";
import { getOffices } from "@/lib/api";
import { getLang, dict, waNumber } from "@/lib/i18n";

const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const search = (Astro.url.searchParams.get("search") || "").trim();
const page = Math.max(1, Number(Astro.url.searchParams.get("page") || 1));
const data = await getOffices({ page, limit: 24, search: search || undefined }, lang).catch(() => null);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=120, stale-while-revalidate=600");

const title = lang === "ar" ? "قائمة المكاتب العقارية في الكويت" : "Real Estate Agents List in Kuwait";
const description = lang === "ar"
  ? "دليل المكاتب العقارية والوسطاء في الكويت: تصفح إعلانات كل مكتب وتواصل معهم مباشرة عبر الاتصال أو واتساب على مستر عقار."
  : "Directory of real estate offices and brokers in Kuwait: browse each office's ads and contact them directly by phone or WhatsApp on Mr Aqar.";
const site = Astro.site!.origin + (Astro.locals.lang === "en" ? "/en" : "");
const jsonLd = data ? [{
  "@context": "https://schema.org", "@type": "ItemList", name: title,
  itemListElement: data.offices.map((o, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}/offices/${o.publicId}`, name: o.name })),
}] : [];
const crumbsLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: t.breadcrumbHome, item: site },
  { "@type": "ListItem", position: 2, name: t.offices, item: `${site}/offices` } ] };
jsonLd.push(crumbsLd as any);
const igUrl = (h?: string) => !h ? "" : h.startsWith("http") ? h : `https://instagram.com/${h.replace(/^@/, "")}`;
const ttUrl = (h?: string) => !h ? "" : h.startsWith("http") ? h : `https://www.tiktok.com/@${h.replace(/^@/, "")}`;
type OfficeLink = { href: string; label: string; cls: string; icon: string; vb: string; fill?: boolean };
const officeLinks = (o: { instagram?: string; tiktok?: string }, wa: string): OfficeLink[] => [
            wa && { href: `https://wa.me/${wa}`, label: "WhatsApp", cls: "text-[#25d366]", icon: '<path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157z"/>', vb: "0 0 448 512", fill: true },
            o.instagram && { href: igUrl(o.instagram), label: "Instagram", cls: "text-[#d62976]", icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>', vb: "0 0 24 24" },
            o.tiktok && { href: ttUrl(o.tiktok), label: "TikTok", cls: "text-ink", icon: '<path d="M16 3c.4 2.6 2 4.2 4.5 4.5v3.2c-1.7 0-3.2-.5-4.5-1.4V15a6 6 0 1 1-6-6v3.3a2.7 2.7 0 1 0 2.7 2.7V3z"/>', vb: "0 0 24 24", fill: true },
          ].filter(Boolean) as OfficeLink[];
const pageHref = (p: number) => `/offices?${new URLSearchParams({ ...(search ? { search } : {}), ...(p > 1 ? { page: String(p) } : {}) })}`;
---
<Base title={title} description={description} canonical={page > 1 ? `/offices?page=${page}` : "/offices"} noindex={Boolean(search)} jsonLd={jsonLd} active="offices">
  <div class="mx-auto max-w-[52rem] px-4 pt-5 pb-12">
    <nav class="text-[12.5px] font-semibold text-muted" aria-label="breadcrumb"><a href="/" class="hover:text-brand">{t.breadcrumbHome}</a> <span aria-hidden="true">›</span> <span>{t.offices}</span></nav>
    <h1 class="mt-2 text-[22px] font-extrabold leading-8 md:text-[26px]">{title}</h1>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      {data && <p class="text-[13px] font-semibold text-muted">{data.total.toLocaleString("en-US")} {lang === "ar" ? "مكتب" : "agents"}</p>}
      <form method="get" action="/offices" class="relative w-full sm:w-72" role="search">
        <span class="sr-only">{t.searchOffices}</span>
        <svg class="pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="search" value={search} placeholder={t.searchOffices} class="h-10 w-full rounded-xl border border-line bg-white ps-9 pe-3 text-[14px] outline-none focus:border-brand" />
      </form>
    </div>

    {data?.offices.length ? (
      <ul class="mt-4 divide-y divide-line overflow-hidden rounded-[18px] border border-line bg-white shadow-[0_2px_10px_rgba(50,40,37,0.05)]">
        {data.offices.map((o) => {
          const wa = o.phoneNumber ? waNumber(o.phoneNumber) : "";
          const links = officeLinks(o, wa);
          return (
            <li class="relative flex gap-3.5 p-4 transition-colors hover:bg-canvas/60">
              <a href={`/offices/${o.publicId}`} class="absolute inset-0 z-0" aria-label={o.name}></a>
              <OfficeAvatar name={o.name} avatar={o.avatar} />
              <div class="relative min-w-0 flex-1 pointer-events-none">
                <h2 class="truncate text-[16px] font-extrabold leading-6 text-ink">{o.name}</h2>
                <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] font-semibold text-muted">
                  <span><b class="font-extrabold text-ink">{(o.adsCount ?? 0).toLocaleString("en-US")}</b> {t.adsCount}</span>
                  {links.length > 0 && <span class="text-line" aria-hidden="true">|</span>}
                  <span class="pointer-events-auto relative z-10 flex items-center gap-1">
                    {links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener nofollow" aria-label={`${o.name} ${l.label}`} class:list={["flex size-7 items-center justify-center rounded-full bg-soft hover:bg-line", l.cls]}>
                        <svg width="14" height="14" viewBox={l.vb} fill={l.fill ? "currentColor" : "none"} stroke={l.fill ? "none" : "currentColor"} stroke-width="2" aria-hidden="true" set:html={l.icon} />
                      </a>
                    ))}
                  </span>
                </div>
                {o.description && <p class="mt-1.5 line-clamp-2 text-[13px] leading-6 text-muted">{o.description}</p>}
              </div>
            </li>
          );
        })}
      </ul>
    ) : <p class="mt-4 rounded-[18px] border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}

    {data && data.totalPages > 1 && (
      <nav class="mt-6 flex items-center justify-center gap-2" aria-label={t.page}>
        {page > 1 && <a href={pageHref(page - 1)} rel="prev" class="flex h-10 items-center rounded-full border border-line bg-white px-4 text-[14px] font-bold">{t.prev}</a>}
        <span class="px-3 text-[13.5px] font-semibold text-muted">{t.page} {page} / {data.totalPages}</span>
        {page < data.totalPages && <a href={pageHref(page + 1)} rel="next" class="flex h-10 items-center rounded-full border border-line bg-white px-4 text-[14px] font-bold">{t.next}</a>}
      </nav>
    )}
  </div>
</Base>
