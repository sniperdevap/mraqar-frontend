---
import Base from "@/layouts/Base.astro";
import GoogleAuth from "@/components/GoogleAuth.astro";
import { getLang } from "@/lib/i18n";
import { apiPost, kwPhone, setSession, safeNext } from "@/lib/auth";

const lang = getLang(Astro.cookies, Astro.locals);
const ar = lang === "ar";
const next = safeNext(Astro.url.searchParams.get("next"));
let phone = "";
let error = "";
let unverified = "";

if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  phone = String(fd.get("phone") || "").replace(/\D/g, "").slice(0, 8);
  const password = String(fd.get("password") || "");
  const phoneNumber = kwPhone(phone);
  if (!phoneNumber) error = ar ? "أدخل رقم الموبايل من 8 أرقام" : "Enter your 8-digit mobile number";
  else if (!password) error = ar ? "أدخل كلمة السر" : "Enter your password";
  else {
    const r = await apiPost("/users/signin", { phoneNumber, password }, lang);
    if (r.ok && r.data?.token) {
      setSession(Astro.cookies, r.data.token, r.data.user, Astro.url.protocol === "https:" || Astro.request.headers.get("x-forwarded-proto") === "https");
      return Astro.redirect(r.data.user?.role === "super_admin" ? "/admin" : next, 303);
    }
    if (r.code === "PHONE_NOT_VERIFIED") unverified = phoneNumber;
    else if (r.status === 401) error = ar ? "رقم الموبايل أو كلمة السر غير صحيحة" : "Wrong mobile number or password";
    else if (r.status === 403) error = ar ? "هذا الحساب موقوف، تواصل مع الدعم" : "This account is inactive, please contact support";
    else error = ar ? "تعذر تسجيل الدخول الآن، حاول مرة أخرى" : "Couldn't sign in right now, please try again";
  }
}
const field = "h-[54px] w-full rounded-2xl border border-line bg-white px-4 text-[15px] text-ink outline-none transition placeholder:text-muted/80 focus:border-brand focus:ring-4 focus:ring-brand/10";
---
<Base title={ar ? "تسجيل الدخول" : "Sign in"} description={ar ? "سجّل الدخول إلى حسابك في مستر عقار برقم موبايلك وكلمة السر أو بحساب Google." : "Sign in to your Mr Aqar account with your mobile number and password, or with Google."} canonical="/auth/signin" noindex active="account">
  <div class="flex justify-center px-4 pt-6 pb-14 md:pt-10">
    <div class="w-full max-w-[460px] rounded-[28px] border border-line bg-white p-6 shadow-[0_18px_48px_rgba(50,40,37,0.08)] md:p-8">
      <h1 class="text-center text-[28px] font-extrabold">{ar ? "دخول" : "Sign in"}</h1>
      <p class="mt-1 text-center text-[14.5px] text-muted">{ar ? "أدخل رقم موبايلك وكلمة السر." : "Enter your mobile number and password."}</p>

      {error && <p class="mt-5 rounded-2xl bg-brand/10 p-3 text-center text-[14px] font-semibold text-brand" role="alert">{error}</p>}
      {unverified && (
        <p class="mt-5 rounded-2xl bg-gold-soft p-3 text-center text-[14px] font-semibold text-[#4a3200]" role="alert">
          {ar ? "رقمك غير مُفعّل بعد." : "Your number isn't verified yet."} <a class="underline" href={`/auth/verify?phoneNumber=${encodeURIComponent(unverified)}&type=signup`}>{ar ? "فعّله الآن" : "Verify now"}</a>
        </p>
      )}

      <form method="post" class="mt-6 space-y-4" novalidate>
        <div class="flex gap-2" dir="ltr">
          <span class="flex h-[54px] shrink-0 items-center gap-1.5 rounded-2xl border border-line bg-soft px-3.5 text-[14px] font-bold"><span class="text-[11px] text-muted">KW</span>+965</span>
          <input name="phone" value={phone} inputmode="numeric" maxlength="8" autocomplete="tel-national" required placeholder={ar ? "رقم الموبايل" : "Mobile number"} class={field} />
        </div>
        <div class="relative">
          <input name="password" type="password" autocomplete="current-password" required placeholder={ar ? "كلمة السر" : "Password"} class={`${field} pe-12`} data-pass />
          <button type="button" class="absolute end-3 top-1/2 -translate-y-1/2 rounded-lg p-1.5 text-muted hover:text-ink" aria-label={ar ? "إظهار كلمة السر" : "Show password"} data-eye>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <button class="flex h-[56px] w-full items-center justify-center gap-2 rounded-2xl bg-brand text-[17px] font-extrabold text-white shadow-[0_10px_24px_rgba(217,54,62,0.22)] transition hover:bg-brand-dark active:scale-[0.99]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.6-4 4.6-6 8-6s6.4 2 8 6"/></svg>
          {ar ? "دخول" : "Sign in"}
        </button>
      </form>

      <div class="mt-5 flex items-center gap-3 text-[13px] font-semibold text-muted" role="separator"><span class="h-px flex-1 bg-line"></span>{ar ? "أو" : "or"}<span class="h-px flex-1 bg-line"></span></div>
      <div class="mt-5"><GoogleAuth lang={lang} next={next} /></div>

      <div class="mt-6 space-y-3 text-center">
        <a href="/auth/forgot-password" class="block text-[15px] font-bold text-brand hover:underline">{ar ? "نسيت كلمة السر؟" : "Forgot your password?"}</a>
        <p class="text-[15px] font-semibold text-muted">{ar ? "مستخدم جديد ولا تمتلك حساب؟" : "New here?"} <a href={`/auth/signup${next !== "/" ? `?next=${encodeURIComponent(next)}` : ""}`} class="font-extrabold text-brand hover:underline">{ar ? "سجّل مجانًا" : "Sign up free"}</a></p>
      </div>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-eye]").forEach((b) => b.addEventListener("click", () => {
      const i = b.parentElement!.querySelector<HTMLInputElement>("[data-pass]")!;
      i.type = i.type === "password" ? "text" : "password";
    }));
  </script>
</Base>
