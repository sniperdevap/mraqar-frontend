---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import { CATEGORIES } from "@/lib/blog";
import { getLang, dict } from "@/lib/i18n";
const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const posts = (await getCollection("blog")).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const [lead, ...rest] = [...posts.filter((p) => p.data.featured), ...posts.filter((p) => !p.data.featured)];
const site = Astro.site!.origin;
const jsonLd = [{ "@context": "https://schema.org", "@type": "Blog", name: t.blogTitle, url: `${site}/blog`, inLanguage: "ar-KW",
  blogPost: posts.map((p) => ({ "@type": "BlogPosting", headline: p.data.title, url: `${site}/blog/${p.id}`, datePublished: p.data.publishedAt.toISOString() })) }];
---
<Base title={t.blogTitle} description={t.blogSub} canonical="/blog" jsonLd={jsonLd} active="blog">
  <div class="mx-auto max-w-6xl px-5 py-8">
    <h1 class="text-[24px] font-extrabold leading-8 md:text-[30px] md:leading-10">{t.blog}</h1>
    <p class="mt-1.5 max-w-2xl text-[14px] leading-6 text-muted">{t.blogSub}</p>
    <nav class="-mx-5 mt-5 flex gap-2 overflow-x-auto px-5 [scrollbar-width:none]" aria-label={t.blog}>
      <a href="/blog" class="shrink-0 rounded-full bg-ink px-4 py-2 text-[13.5px] font-bold text-white">{t.allPosts}</a>
      {Object.entries(CATEGORIES).map(([k, v]) => <a href={`/blog/category/${k}`} class="shrink-0 rounded-full border border-line bg-white px-4 py-2 text-[13.5px] font-semibold text-ink hover:border-brand hover:text-brand">{v[lang]}</a>)}
    </nav>
    <a href="/areas" class="mt-5 flex items-center gap-3 rounded-[18px] border border-line bg-white p-4 shadow-[0_2px_10px_rgba(50,40,37,0.06)] hover:border-brand">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
      <span class="min-w-0 flex-1"><span class="block text-[15px] font-extrabold text-ink">{lang === "ar" ? "دليل مناطق الكويت" : "Kuwait areas guide"}</span><span class="block text-[12.5px] text-muted">{lang === "ar" ? "صفحة لكل منطقة: نبذة، عناوين، وأحدث العقارات" : "A page for every area, with its latest listings"}</span></span>
      <svg class="shrink-0 text-muted rtl:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
    </a>
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {lead && <PostCard post={lead} lang={lang} large eager />}
      {rest.map((p) => <PostCard post={p} lang={lang} />)}
    </div>
  </div>
</Base>
