---
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import { CATEGORIES, readingMinutes, formatDate } from "@/lib/blog";
import { getLang, dict } from "@/lib/i18n";
const lang = getLang(Astro.cookies);
const t = dict(lang);
const post = await getEntry("blog", Astro.params.slug!);
if (!post) return Astro.rewrite("/404");
const { Content, headings } = await render(post);
const related = (await getCollection("blog", (p) => p.id !== post.id))
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category) || +b.data.publishedAt - +a.data.publishedAt)
  .slice(0, 2);
const site = Astro.site!.origin;
const url = `${site}/blog/${post.id}`;
const cat = CATEGORIES[post.data.category][lang];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BlogPosting", headline: post.data.title, description: post.data.description, url, mainEntityOfPage: url,
    datePublished: post.data.publishedAt.toISOString(), dateModified: (post.data.updatedAt || post.data.publishedAt).toISOString(), inLanguage: "ar-KW",
    author: { "@type": "Organization", name: post.data.author }, publisher: { "@type": "Organization", name: "مستر عقار", logo: { "@type": "ImageObject", url: `${site}/icon-512.png` } },
    image: post.data.cover ? new URL(post.data.cover, site).href : `${site}/aqar-new-logo.png`, articleSection: cat, wordCount: (post.body || "").split(/\s+/).length },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: t.breadcrumbHome, item: site },
    { "@type": "ListItem", position: 2, name: t.blog, item: `${site}/blog` },
    { "@type": "ListItem", position: 3, name: cat, item: `${site}/blog/category/${post.data.category}` },
    { "@type": "ListItem", position: 4, name: post.data.title, item: url } ] },
];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={post.data.title} description={post.data.description} canonical={`/blog/${post.id}`} jsonLd={jsonLd} active="blog">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    <meta property="article:section" content={cat} />
  </Fragment>
  <article class="mx-auto max-w-2xl px-4 pt-6 pb-12">
    <nav class="text-[13px] text-muted" aria-label="Breadcrumb">
      <a href="/blog" class="hover:text-brand">{t.blog}</a> <span aria-hidden="true">/</span> <a href={`/blog/category/${post.data.category}`} class="hover:text-brand">{cat}</a>
    </nav>
    <h1 class="mt-3 text-[27px] font-bold leading-[1.55] sm:text-[32px]">{post.data.title}</h1>
    <p class="mt-3 text-[16px] leading-8 text-muted">{post.data.description}</p>
    <p class="mt-3 text-[13.5px] text-muted">{post.data.author} · <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, lang)}</time> · {readingMinutes(post.body)} {t.minRead}</p>
    {toc.length > 2 && (
      <nav class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-line" aria-label="Contents">
        <p class="mb-2 text-[14px] font-bold">{lang === "ar" ? "محتويات المقال" : "Contents"}</p>
        <ol class="space-y-1.5 text-[14.5px]">{toc.map((h) => <li><a href={`#${h.slug}`} class="text-ink-2 hover:text-brand">{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose-ar mt-6 text-[16.5px] text-ink"><Content /></div>
    <div class="mt-10 rounded-3xl bg-ink p-6 text-white">
      <p class="text-[19px] font-bold">{lang === "ar" ? "جاهز تبدأ البحث؟" : "Ready to start searching?"}</p>
      <p class="mt-1.5 text-[14.5px] text-white/70">{t.heroSub}</p>
      <a href="/search" class="mt-4 inline-flex h-12 items-center rounded-xl bg-brand px-6 text-[15px] font-semibold">{t.searchBtn}</a>
    </div>
  </article>
  {related.length > 0 && (
    <section class="mx-auto max-w-2xl px-4 pb-12">
      <h2 class="mb-4 text-[20px] font-bold">{t.relatedPosts}</h2>
      <div class="grid gap-4 sm:grid-cols-2">{related.map((p) => <PostCard post={p} lang={lang} />)}</div>
    </section>
  )}
</Base>
