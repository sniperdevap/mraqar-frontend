---
import Base from "@/layouts/Base.astro";
import AdCard from "@/components/AdCard.astro";
import AreaPicker from "@/components/AreaPicker.astro";
import { getAd, getAds, getAreas, getPropertyTypes } from "@/lib/api";
import { getLang, dict } from "@/lib/i18n";
import { pluralSlug, adHref } from "@/lib/ad-url";
import { areaGuidePath } from "@/lib/area-guides";

const lang = getLang(Astro.cookies, Astro.locals);
const t = dict(lang);
const q = Astro.url.searchParams;
const purpose = ["sale", "rent", "exchange"].includes(q.get("purpose") || "") ? q.get("purpose")! : "";
const propertyType = q.get("propertyType") || "";
const area = q.getAll("area").filter(Boolean);
const minPrice = q.get("minPrice") || "";
const maxPrice = q.get("maxPrice") || "";
const page = Math.max(1, Number(q.get("page") || 1));
// Free text, or an ad number ("4063" / "#4063") which opens that ad directly.
const text = (q.get("q") || "").trim().slice(0, 60);
const code = text.replace(/^#/, "");
if (/^\d{2,9}$/.test(code)) {
  const [found, allAreas] = await Promise.all([getAd(code, lang).catch(() => null), getAreas(lang).catch(() => [])]);
  if (found) return Astro.redirect(adHref(found, allAreas), 302);
}
const LIMIT = 20;
const purposeNames: Record<string, string> = { sale: t.sale, rent: t.rent, exchange: t.exchange };

const [areas, types, result] = await Promise.all([
  getAreas(lang).catch(() => []),
  getPropertyTypes(lang).catch(() => []),
  getAds({ page, limit: LIMIT, purpose: purpose || undefined, propertyType: propertyType || undefined, area, minPrice: minPrice ? Number(minPrice) : undefined, maxPrice: maxPrice ? Number(maxPrice) : undefined, status: "active", search: text || undefined }, lang).catch(() => null),
]);
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=120");

// Page heading as people search it: "شقق للإيجار في سلوى"
const type = types.find((x) => String(x.id) === propertyType);
const areaNames = areas.filter((a) => area.includes(String(a.id))).map((a) => (lang === "ar" ? a.labelAr : a.label));
const purposeLabel = purpose ? (t as Record<string, string>)[purpose] : "";
const typeLabel = type ? (lang === "ar" ? type.labelAr : pluralSlug(type.label).replace(/-/g, " ")) : lang === "ar" ? "عقارات" : "Properties";
const where = areaNames.length ? areaNames.join(lang === "ar" ? "، " : ", ") : t.kuwait;
const heading = lang === "ar" ? `${typeLabel} ${purposeLabel} في ${where}`.replace(/\s+/g, " ") : `${typeLabel[0].toUpperCase()}${typeLabel.slice(1)} ${purposeLabel.toLowerCase()} in ${where}`.replace(/\s+/g, " ");
const total = result?.total ?? 0;
const description = lang === "ar"
  ? `${total.toLocaleString("en-US")} إعلان: ${heading}. تصفح الأسعار والصور وتواصل مباشرة مع الملاك والمكاتب على مستر عقار.`
  : `${total.toLocaleString("en-US")} listings: ${heading}. Browse prices and photos and contact owners and offices directly on Mr Aqar.`;

const keep = new URLSearchParams();
if (purpose) keep.set("purpose", purpose);
if (propertyType) keep.set("propertyType", propertyType);
area.forEach((a) => keep.append("area", a));
const canonicalParams = new URLSearchParams(keep);
if (page > 1) canonicalParams.set("page", String(page));
const canonical = `/search${canonicalParams.toString() ? `?${canonicalParams}` : ""}`;
const pageHref = (p: number) => { const s = new URLSearchParams(keep); if (text) s.set("q", text); if (minPrice) s.set("minPrice", minPrice); if (maxPrice) s.set("maxPrice", maxPrice); if (p > 1) s.set("page", String(p)); return `/search?${s}`; };

// Area guide block (shown when one area is picked): the area plus nearby areas in
// the same governorate, each with the four searches people make most.
const chosenArea = area.length === 1 ? areas.find((a) => String(a.id) === area[0]) : undefined;
const linkPurpose = purpose || "rent";
const linkPurposeLabel = (t as Record<string, string>)[linkPurpose];
const typeByValue = (v: string) => types.find((x) => x.value === v);
const linkTypes = [
  { ty: undefined, ar: "عقارات", en: "Properties" },
  { ty: typeByValue("house"), ar: "بيوت", en: "Houses" },
  { ty: typeByValue("land"), ar: "اراضي", en: "Land" },
  { ty: typeByValue("apartment"), ar: "شقق", en: "Apartments" },
];
const areaName = (a: (typeof areas)[number]) => (lang === "ar" ? a.labelAr : a.label);
const guideAreas = chosenArea
  ? [chosenArea, ...areas.filter((a) => a.governorate === chosenArea.governorate && a.id !== chosenArea.id).slice(0, 5)]
  : [];
const guideHref = (a: (typeof areas)[number], tyId?: number) => {
  const s = new URLSearchParams({ purpose: linkPurpose });
  if (tyId) s.set("propertyType", String(tyId));
  s.append("area", String(a.id));
  return `/search?${s}`;
};

const site = Astro.site!.origin + (Astro.locals.lang === "en" ? "/en" : "");
const crumbs = [{ name: t.breadcrumbHome, item: site }, ...(purpose ? [{ name: purposeLabel, item: `${site}/search?purpose=${purpose}` }] : []), { name: heading, item: `${site}${canonical}` }];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })) },
];
---
<Base title={heading} description={description} canonical={canonical} noindex={Boolean(minPrice || maxPrice || text) || area.length > 1 || total === 0 || (result ? page > result.totalPages : false)} jsonLd={jsonLd} active="search">
  <div class="mx-auto max-w-[52rem] px-5 pt-6 pb-12">
    <h1 class="text-[22px] font-extrabold leading-8">{area.length || propertyType || purpose ? heading : (lang === "ar" ? "نتائج العقارات" : "Property results")}</h1>
    <p class="mt-0.5 text-[13px] font-semibold text-muted">{total.toLocaleString("en-US")} {lang === "ar" ? "نتيجة" : "results"}</p>

    <form method="get" action="/search" class="mt-4 space-y-3" data-search-form data-autosubmit>
      <AreaPicker lang={lang} areas={areas} selected={area} icon="search" />
      <div class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 [scrollbar-width:none]">
        <label class="relative shrink-0">
          <span class="sr-only">{lang === "ar" ? "الغرض" : "Purpose"}</span>
          <select name="purpose" class:list={["h-10 appearance-none rounded-full border bg-white ps-4 pe-9 text-[14px] font-bold outline-none", purpose ? "border-brand text-brand-deep" : "border-line text-ink"]}>
            <option value="">{lang === "ar" ? "الغرض" : "Purpose"}</option>
            {["sale", "rent", "exchange"].map((v) => <option value={v} selected={purpose === v}>{purposeNames[v]}</option>)}
          </select>
          <svg class="pointer-events-none absolute end-3.5 top-1/2 -translate-y-1/2 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </label>
        <label class="relative shrink-0">
          <span class="sr-only">{t.propertyType}</span>
          <select name="propertyType" class:list={["h-10 appearance-none rounded-full border bg-white ps-4 pe-9 text-[14px] font-medium outline-none", propertyType ? "border-brand text-brand-deep" : "border-line text-ink"]}>
            <option value="">{t.propertyType}</option>
            {types.map((ty) => <option value={String(ty.id)} data-slug={ty.label.toLowerCase()} selected={propertyType === String(ty.id)}>{lang === "ar" ? ty.labelAr : ty.label}</option>)}
          </select>
          <svg class="pointer-events-none absolute end-3.5 top-1/2 -translate-y-1/2 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </label>
        <label class="relative shrink-0">
          <span class="sr-only">{lang === "ar" ? "السعر" : "Price"}</span>
          <select name="maxPrice" class:list={["h-10 appearance-none rounded-full border bg-white ps-4 pe-9 text-[14px] font-medium outline-none", maxPrice ? "border-brand text-brand-deep" : "border-line text-ink"]}>
            <option value="">{lang === "ar" ? "السعر (د.ك)" : "Price (KD)"}</option>
            {[500, 1000, 100000, 250000, 500000, 1000000].map((v) => <option value={v} selected={maxPrice === String(v)}>{(lang === "ar" ? "حتى " : "Up to ") + v.toLocaleString("en-US")}</option>)}
          </select>
          <svg class="pointer-events-none absolute end-3.5 top-1/2 -translate-y-1/2 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </label>
        <button type="button" class:list={["flex h-10 shrink-0 items-center gap-1.5 rounded-full border bg-white px-4 text-[14px] font-medium", text ? "border-brand text-brand-deep" : "border-line text-ink"]} data-keyword-toggle aria-expanded={text ? "true" : "false"}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          {lang === "ar" ? "كلمات" : "Keywords"}
        </button>
        {(purpose || propertyType || area.length || maxPrice || text) && <a href="/search" class="flex h-10 shrink-0 items-center rounded-full px-3 text-[13.5px] font-semibold text-muted hover:text-brand">{t.clear}</a>}
      </div>
      <div class:list={["flex gap-2", !text && "hidden"]} data-keyword-box>
        <input type="search" name="q" value={text} enterkeyhint="search" maxlength="60" autocomplete="off"
          placeholder={lang === "ar" ? "كلمة أو رقم إعلان" : "Keyword or ad number"} aria-label={lang === "ar" ? "كلمات" : "Keywords"}
          class="h-10 min-w-0 flex-1 rounded-full border border-line bg-white px-4 text-[14px] outline-none focus:border-brand" />
        <button class="h-10 shrink-0 rounded-full bg-ink px-4 text-[13px] font-bold text-white">{lang === "ar" ? "تطبيق" : "Apply"}</button>
      </div>
    </form>

    {result?.ads.length ? (
      <div class="mt-5 grid grid-cols-1 gap-2" data-ad-list>{result.ads.map((ad, i) => <AdCard ad={ad} areas={areas} lang={lang} eager={i < 3} headingLevel="h2" />)}</div>
    ) : <p class="mt-6 rounded-[18px] border border-dashed border-line bg-white p-10 text-center text-muted">{t.noAds}</p>}

    {result && page < result.totalPages && (
      <div class="mt-7 text-center">
        <a href={pageHref(page + 1)} rel="next" data-load-more class="inline-flex h-12 items-center rounded-full bg-soft px-7 text-[15px] font-bold text-ink hover:bg-line">{lang === "ar" ? "تحميل المزيد" : "Load more"}</a>
      </div>
    )}
    <script>
      // "Load more" adds the next page's ads under the ones already shown, instead of
      // replacing the list. Without JavaScript the link still opens the next page.
      const more = document.querySelector<HTMLAnchorElement>("[data-load-more]");
      const list = document.querySelector<HTMLElement>("[data-ad-list]");
      more?.addEventListener("click", async (e) => {
        if (!list || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        more.setAttribute("aria-busy", "true");
        more.textContent = document.documentElement.lang === "en" ? "Loading…" : "جارٍ التحميل…";
        try {
          const res = await fetch(more.href, { headers: { Accept: "text/html" } });
          if (!res.ok) throw new Error(String(res.status));
          const doc = new DOMParser().parseFromString(await res.text(), "text/html");
          const next = doc.querySelector<HTMLElement>("[data-ad-list]");
          if (!next) throw new Error("no list");
          list.append(...Array.from(next.children));
          const nextMore = doc.querySelector<HTMLAnchorElement>("[data-load-more]");
          if (nextMore) {
            more.href = nextMore.getAttribute("href") || more.href;
            more.textContent = nextMore.textContent;
            more.removeAttribute("aria-busy");
          } else {
            more.parentElement?.remove();
          }
        } catch {
          window.location.href = more.href;
        }
      });
    </script>
    {page > 1 && <p class="mt-3 text-center"><a href={pageHref(page - 1)} rel="prev" class="text-[13.5px] text-muted hover:text-brand">{t.prev}</a></p>}

    {chosenArea && (
      <section class="mt-10 border-t border-line pt-6" aria-labelledby="area-guide">
        <h2 id="area-guide" class="text-[16px] font-extrabold text-ink">{heading}</h2>
        <p class="mt-1.5 text-[13.5px] leading-7 text-muted">
          {lang === "ar"
            ? `إعلانات ${linkPurposeLabel} في ${areaName(chosenArea)} من الملاك والمكاتب، تواصل مع المعلن مباشرة بالاتصال أو واتساب.`
            : `Listings ${linkPurposeLabel.toLowerCase()} in ${areaName(chosenArea)} from owners and offices. Contact the advertiser directly by phone or WhatsApp.`}
        </p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
          {guideAreas.map((a) => (
            <div class="min-w-0">
              <h3 class="text-[14.5px] font-extrabold text-ink"><a href={areaGuidePath(a)} class="hover:text-brand">{lang === "ar" ? `منطقة ${areaName(a)}` : areaName(a)}</a></h3>
              <ul class="mt-2 space-y-2">
                {linkTypes.map((lt) => (
                  <li><a href={guideHref(a, lt.ty?.id)} class="text-[13px] text-muted hover:text-brand">{lang === "ar" ? `${lt.ar} ${linkPurposeLabel} في ${areaName(a)}` : `${lt.en} ${linkPurposeLabel.toLowerCase()} in ${areaName(a)}`}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    // "كلمات" pill shows the keyword field.
    document.querySelectorAll<HTMLButtonElement>("[data-keyword-toggle]").forEach((b) => b.addEventListener("click", () => {
      const box = b.closest("form")!.querySelector<HTMLElement>("[data-keyword-box]")!;
      box.classList.toggle("hidden");
      b.setAttribute("aria-expanded", String(!box.classList.contains("hidden")));
      box.querySelector("input")?.focus();
    }));
    // Filters apply as soon as they change (area picks submit too).
    document.querySelectorAll<HTMLFormElement>("[data-autosubmit]").forEach((f) => {
      f.querySelectorAll("select").forEach((s) => s.addEventListener("change", () => f.requestSubmit()));
      new MutationObserver(() => f.requestSubmit()).observe(f.querySelector("[data-area-box]")!, { childList: true });
    });
  </script>
</Base>
