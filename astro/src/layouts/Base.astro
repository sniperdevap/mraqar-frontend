---
import "@/styles/global.css";
import { getLang, dict, SUPPORT_WA, SUPPORT_PHONE, APP_STORE, PLAY_STORE } from "@/lib/i18n";
import { getPropertyTypes } from "@/lib/api";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  active?: "home" | "offices" | "blog" | "search" | "add" | "account";
  hideFooter?: boolean;
  bottomBar?: boolean;
  back?: boolean;
}
const { title, description, canonical, image, noindex, jsonLd = [], active, hideFooter = false, bottomBar = true, back = false } = Astro.props;
const lang = getLang(Astro.cookies);
const t = dict(lang);
const dir = lang === "ar" ? "rtl" : "ltr";
const site = Astro.site!.origin;
const canonicalUrl = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
const ogImage = image || `${site}/aqar-new-logo.png`;
const fullTitle = title.includes(t.siteName) ? title : `${title} | ${t.siteName}`;
const types = await getPropertyTypes(lang).catch(() => []);

const org = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "مستر عقار",
  alternateName: "Mr Aqar",
  url: site,
  logo: `${site}/icon-512.png`,
  image: `${site}/aqar-new-logo.png`,
  telephone: SUPPORT_PHONE,
  areaServed: { "@type": "Country", name: "Kuwait" },
  sameAs: [APP_STORE, PLAY_STORE],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "مستر عقار",
  url: site,
  inLanguage: ["ar-KW", "en"],
  potentialAction: { "@type": "SearchAction", target: `${site}/search?q={search_term_string}`, "query-input": "required name=search_term_string" },
};
const ld = (d: unknown) => JSON.stringify(d).replace(/</g, "\\u003c");

const navItems = [
  { key: "home", href: "/", label: t.home, icon: "home" },
  { key: "offices", href: "/offices", label: t.offices, icon: "building" },
  { key: "add", href: "/auth/signin?next=/ads/create", label: t.addAd, icon: "plus" },
  { key: "search", href: "/search", label: t.search, icon: "search" },
  { key: "account", href: "/auth/signin", label: t.account, icon: "user" },
] as const;
const drawerItems = [
  { k: "home", href: "/", label: t.home, icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>' },
  { k: "offices", href: "/offices", label: t.offices, icon: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h1.5M13.5 7H15M9 11h1.5M13.5 11H15M9 15h1.5M13.5 15H15"/>' },
  { k: "blog", href: "/blog", label: t.blog, icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/>' },
  { k: "search", href: "/search", label: t.search, icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { k: "myads", href: "/account?tab=my-ads", label: lang === "ar" ? "إعلاناتي" : "My ads", icon: '<path d="M12 21s-7-4.4-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12C19 16.6 12 21 12 21z"/>' },
  { k: "app", href: APP_STORE, ext: true, label: lang === "ar" ? "التطبيق" : "The app", icon: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18h2"/>' },
  { k: "contact", href: "/contact", label: t.contact, icon: '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>' },
];
const drawerLinks = [
  { href: "/", label: t.home }, { href: "/search?purpose=sale", label: t.sale }, { href: "/search?purpose=rent", label: t.rent },
  { href: "/search?purpose=exchange", label: t.exchange }, { href: "/offices", label: t.offices }, { href: "/blog", label: t.blog },
  { href: "/about", label: t.about }, { href: "/contact", label: t.contact }, { href: "/privacy", label: t.privacy }, { href: "/terms", label: t.terms },
];
const icons: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  building: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M10 21v-4h4v4"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.6-4 4.6-6 8-6s6.4 2 8 6"/>',
};
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="مستر عقار" />
    <meta property="og:locale" content={lang === "ar" ? "ar_KW" : "en_US"} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/atom+xml" title="مستر عقار — أحدث الإعلانات" href="/feed.xml" />
    <script type="application/ld+json" set:html={ld(org)} />
    <script type="application/ld+json" set:html={ld(website)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={ld(d)} />)}
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col antialiased">
    <!-- App banner (phones), like Awwad's: dismissible, remembered per browser -->
    <div id="app-banner" class="flex items-center gap-3 border-b border-line bg-white px-4 py-3 lg:hidden" hidden>
      <button type="button" class="flex size-8 shrink-0 items-center justify-center text-ink/70" aria-label={t.closeMenu} data-banner-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <img src="/icon-192.png" alt="" width="48" height="48" class="size-12 shrink-0 rounded-xl ring-1 ring-line" loading="lazy" />
      <div class="min-w-0 flex-1">
        <p class="truncate text-[15px] font-bold">{lang === "ar" ? "تطبيق مستر عقار" : "Mr Aqar app"}</p>
        <p class="text-[12.5px] text-muted"><span class="text-gold">★★★★★</span> {lang === "ar" ? "تحميل مجاني" : "Free download"}</p>
      </div>
      <a href={APP_STORE} data-app-link class="shrink-0 rounded-full bg-brand px-4 py-2 text-[13.5px] font-semibold text-white">{lang === "ar" ? "تنزيل" : "Get"}</a>
    </div>

    <header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur" style="padding-top: env(safe-area-inset-top, 0px)">
      <div class="relative mx-auto flex h-[68px] max-w-6xl items-center px-4" dir="ltr">
        <!-- Menu icon on the left (two lines) -->
        <button type="button" class="z-10 flex size-11 items-center justify-center rounded-xl text-ink hover:bg-canvas" aria-label={t.openMenu} aria-controls="drawer" aria-expanded="false" data-drawer-open>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"/></svg>
        </button>
        <!-- Logo in the centre -->
        <a href="/" class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center" aria-label={t.siteName}>
          <img src="/aqar-new-logo-nav.webp" alt="Mr Aqar مستر عقار" width="80" height="52" class="h-12 w-auto" fetchpriority="high" />
        </a>
        {back && (
          <button type="button" class="z-10 ms-auto flex size-10 items-center justify-center rounded-xl text-ink hover:bg-canvas lg:hidden" aria-label={lang === "ar" ? "رجوع" : "Back"} data-back>
            <svg class:list={[lang === "en" && "rotate-180"]} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </button>
        )}
        <nav class="z-10 ms-auto hidden items-center gap-1 lg:flex" dir={dir} aria-label="Main">
          {[{ href: "/", label: t.home, k: "home" }, { href: "/offices", label: t.offices, k: "offices" }, { href: "/blog", label: t.blog, k: "blog" }].map((l) => (
            <a href={l.href} class:list={["rounded-lg px-3.5 py-2 text-[15px] transition-colors hover:bg-canvas", active === l.k ? "font-semibold text-brand" : "text-ink"]}>{l.label}</a>
          ))}
          <a href="/auth/signin?next=/ads/create" class="ms-2 flex h-11 items-center gap-2 rounded-xl bg-brand px-4 text-[14.5px] font-semibold text-white hover:bg-brand-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{t.addAd}
          </a>
        </nav>
      </div>
    </header>

    <!-- Side menu -->
    <div id="drawer" class="drawer fixed inset-0 z-50" data-open="false" aria-hidden="true">
      <div class="drawer-scrim absolute inset-0 bg-black/45 backdrop-blur-[2px]" data-drawer-close></div>
      <aside class="drawer-panel absolute inset-y-0 right-0 flex w-[82%] max-w-[360px] flex-col bg-white shadow-2xl" dir={dir} role="dialog" aria-modal="true" aria-label={t.menu} style="padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px)">
        <div class="flex items-center justify-between px-4 pt-4 pb-3">
          <a href="/" class="flex items-center gap-2.5">
            <img src="/aqar-new-logo-nav.webp" alt="" width="62" height="40" class="h-10 w-auto" />
            <span class="text-[17px] font-bold">{t.siteName}</span>
          </a>
          <button type="button" class="flex size-11 items-center justify-center rounded-full bg-canvas text-ink/70 hover:bg-line" aria-label={t.closeMenu} data-drawer-close>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="flex-1 overflow-y-auto px-3 pb-3" aria-label={t.menu}>
          {drawerItems.map((l) => (
            <a href={l.href} target={l.ext ? "_blank" : undefined} rel={l.ext ? "noopener" : undefined}
              class:list={["mb-1 flex h-14 items-center gap-3.5 rounded-2xl px-4 text-[17px] font-semibold transition-colors", active === l.k ? "bg-brand-soft text-brand" : "text-ink hover:bg-canvas"]}
              aria-current={active === l.k ? "page" : undefined}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true" set:html={l.icon} />
              {l.label}
            </a>
          ))}
        </nav>
        <div class="space-y-3 border-t border-line px-4 pt-4 pb-4">
          <a href="/auth/signin" class="flex h-14 items-center gap-3.5 rounded-2xl bg-canvas px-4 text-[16px] font-semibold">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.6-4 4.6-6 8-6s6.4 2 8 6"/></svg>
            <span class="flex-1">{t.account}</span>
            <svg class="text-ink/50 rtl:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </a>
          <div class="flex gap-3">
            <form method="post" action="/api/lang" class="flex-1">
              <input type="hidden" name="lang" value={lang === "ar" ? "en" : "ar"} />
              <input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search} />
              <button class="flex h-13 w-full items-center justify-center gap-2.5 rounded-2xl bg-canvas text-[15.5px] font-bold" aria-label={t.language}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                {t.langCode}
              </button>
            </form>
            <a href="/auth/signin" class="flex h-13 w-14 items-center justify-center rounded-2xl bg-canvas" aria-label={t.login}>
              <svg class="rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && (
      <footer class:list={["bg-ink text-white", bottomBar && "pb-20 lg:pb-0"]}>
        <div class="mx-auto max-w-6xl px-5 pt-12 pb-8 lg:px-8">
          <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:gap-x-10">
            <div class="col-span-2 lg:col-span-1">
              <a href="/" class="inline-flex items-center gap-3">
                <span class="flex size-12 items-center justify-center rounded-2xl bg-white p-1.5"><img src="/aqar-new-logo-nav.webp" alt="" width="40" height="26" class="h-auto w-10" loading="lazy" /></span>
                <span class="text-xl font-bold">{t.siteName}</span>
              </a>
              <p class="mt-4 max-w-sm text-[14.5px] leading-7 text-white/70">{t.footerAbout}</p>
              <div class="mt-5 flex gap-2.5">
                <a href={SUPPORT_WA} target="_blank" rel="noopener" aria-label={t.whatsapp} class="flex size-11 items-center justify-center rounded-xl bg-white/[0.08] hover:bg-white/15">
                  <svg width="20" height="20" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157z"/></svg>
                </a>
                <a href={`tel:${SUPPORT_PHONE}`} aria-label={t.callNow} class="flex size-11 items-center justify-center rounded-xl bg-white/[0.08] hover:bg-white/15">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                </a>
              </div>
            </div>
            <nav aria-label={t.propertyTypes}>
              <h2 class="mb-4 text-[15px] font-bold">{t.propertyTypes}</h2>
              <ul class="space-y-3">
                {types.map((ty) => <li><a href={`/search?propertyType=${ty.id}`} class="text-[14.5px] text-white/70 hover:text-white">{lang === "ar" ? ty.labelAr : ty.label}</a></li>)}
              </ul>
            </nav>
            <nav aria-label={t.sitePages}>
              <h2 class="mb-4 text-[15px] font-bold">{t.sitePages}</h2>
              <ul class="space-y-3">
                {[{ h: "/", l: t.home }, { h: "/search?purpose=sale", l: t.sale }, { h: "/search?purpose=rent", l: t.rent }, { h: "/search?purpose=exchange", l: t.exchange }, { h: "/offices", l: t.offices }, { h: "/blog", l: t.blog }, { h: "/about", l: t.about }, { h: "/contact", l: t.contact }, { h: "/privacy", l: t.privacy }, { h: "/terms", l: t.terms }, { h: "/copyright", l: t.copyright }].map((x) => (
                  <li><a href={x.h} class="text-[14.5px] text-white/70 hover:text-white">{x.l}</a></li>
                ))}
              </ul>
            </nav>
            <div class="col-span-2 lg:col-span-1">
              <h2 class="mb-4 text-[15px] font-bold">{t.getApp}</h2>
              <div class="grid grid-cols-2 gap-3 lg:grid-cols-1">
                {[{ h: APP_STORE, n: "App Store" }, { h: PLAY_STORE, n: "Google Play" }].map((s) => (
                  <a href={s.h} target="_blank" rel="noopener" class="flex h-14 items-center gap-3 rounded-2xl bg-white/[0.08] px-4 hover:bg-white/15">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>
                    <span class="leading-tight"><span class="block text-[11.5px] text-white/70">{t.downloadOn}</span><span class="block text-[15px] font-semibold">{s.n}</span></span>
                  </a>
                ))}
              </div>
              <a href={SUPPORT_WA} target="_blank" rel="noopener" class="mt-3 flex items-center gap-3 rounded-2xl border border-white/10 px-4 py-3.5 hover:bg-white/[0.06]">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg></span>
                <span class="leading-tight"><span class="block text-[13px] text-white/70">{t.needHelp}</span><span class="block text-[15px] font-semibold">{t.support}</span></span>
              </a>
            </div>
          </div>
          <p class="mt-10 border-t border-white/10 pt-6 text-center text-[13px] text-white/60">© {new Date().getFullYear()} {t.siteName} — {t.rights}</p>
        </div>
      </footer>
    )}

    {bottomBar && (
      <nav class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-white lg:hidden" style="padding-bottom: env(safe-area-inset-bottom, 0px)" aria-label="Bottom">
        <div class="mx-auto grid h-[62px] max-w-lg grid-cols-5 items-center">
          {navItems.map((n) => n.key === "add" ? (
            <a href={n.href} class="flex flex-col items-center justify-center gap-1" aria-label={n.label}>
              <span class="flex size-9 items-center justify-center rounded-xl bg-brand text-white">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true" set:html={icons[n.icon]} />
              </span>
              <span class="text-[11px] font-semibold text-ink">{n.label}</span>
            </a>
          ) : (
            <a href={n.href} class:list={["flex flex-col items-center justify-center gap-1 text-[11px]", active === n.key ? "font-bold text-ink" : "font-medium text-muted"]} aria-current={active === n.key ? "page" : undefined}>
              <span class="flex size-9 items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill={active === n.key ? "currentColor" : "none"} fill-opacity={active === n.key ? "0.12" : undefined} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[n.icon]} />
              </span>
              {n.label}
            </a>
          ))}
        </div>
      </nav>
    )}

    <script>
      const drawer = document.getElementById("drawer")!;
      const opener = document.querySelector<HTMLButtonElement>("[data-drawer-open]");
      const setOpen = (open: boolean) => {
        drawer.dataset.open = String(open);
        drawer.setAttribute("aria-hidden", String(!open));
        opener?.setAttribute("aria-expanded", String(open));
        document.documentElement.style.overflow = open ? "hidden" : "";
      };
      opener?.addEventListener("click", () => setOpen(true));
      drawer.querySelectorAll("[data-drawer-close]").forEach((el) => el.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));

      document.querySelector("[data-back]")?.addEventListener("click", () => {
        const fromHere = document.referrer && new URL(document.referrer).origin === location.origin;
        if (fromHere && history.length > 1) history.back(); else location.href = "/";
      });

      // App banner: Play Store on Android, App Store otherwise; hidden once closed.
      const banner = document.getElementById("app-banner");
      let dismissed = false;
      try { dismissed = localStorage.getItem("appBannerClosed") === "1"; } catch {}
      if (banner && !dismissed) {
        banner.hidden = false;
        if (/android/i.test(navigator.userAgent)) banner.querySelector<HTMLAnchorElement>("[data-app-link]")!.href = "https://play.google.com/store/apps/details?id=com.mraqar.app";
        banner.querySelector("[data-banner-close]")?.addEventListener("click", () => {
          banner.hidden = true;
          try { localStorage.setItem("appBannerClosed", "1"); } catch {}
        });
      }
    </script>
  </body>
</html>
